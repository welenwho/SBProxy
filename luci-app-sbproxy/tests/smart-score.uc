'use strict';
import { observe, observeSession, score, eligibleNodes, decide } from 'smart_score';
function assert(ok, message) { if (!ok) die(message); }
const now = 10000;
const fast = observe(null, [80, 90, 100], now);
const slow = observe(null, [400, 410, 420], now);
const unstable = observe(null, [20, null, null], now);
const partial = observe(null, [80, 90, null], now);
assert(partial.healthy && partial.loss > 0.333 && partial.loss < 0.334, 'One failed target is one third loss');
assert(unstable.loss > 0.666 && unstable.loss < 0.667, 'Two failed targets are two thirds loss');
assert(observe(null, [], now).loss === 1.0, 'Empty observation is full loss');
assert(score(fast, now) < score(slow, now), 'Latency ranking');
assert(score(unstable, now) > score(slow, now), 'Unreliable nodes must not win');
assert(score(fast, now + 181) === 1000000000, 'Stale sample excluded');
let state = { fallback: 'fallback', switched: now - 200 };
const samples = { fast, slow };
assert(decide(state, samples, ['fast', 'slow'], 'fallback', now) === 'fast', 'Bootstrap');
assert(!decide(state, samples, ['fast', 'slow'], 'slow', now), 'First win held');
assert(!decide(state, samples, ['fast', 'slow'], 'slow', now + 60), 'Second win held');
assert(decide(state, samples, ['fast', 'slow'], 'slow', now + 120) === 'fast', 'Three wins switch');
state = { fallback: 'fallback', switched: now - 10 };
for (let i = 0; i < 3; i++) assert(!decide(state, samples, ['fast', 'slow'], 'slow', now), 'Cooldown');
let failed = observe(null, [null, null, null], now);
samples.slow = failed;
assert(!decide(state, samples, ['fast', 'slow'], 'slow', now), 'Single failure held');
samples.slow = observe(failed, [null, null, null], now + 1);
assert(decide(state, samples, ['fast', 'slow'], 'slow', now + 1) === 'fast', 'Failure bypasses cooldown');
assert(!decide(state, {}, ['fast', 'slow'], 'slow', now), 'All unavailable retain current');
assert(!decide(state, {fast}, ['fast'], 'slow', now), 'Unprobed current is not bootstrap');
const measured = {...fast, speed: 10000, speed_checked: now};
assert(score(measured, now) > score({...slow, speed: 10000000, speed_checked: now}, now), 'Throughput can outweigh latency');
assert(score({...fast, speed: 1, speed_checked: now}, now) < 1000000000, 'Failed speed probe is not node failure');
assert(score({...fast, speed: 1, speed_checked: now - 1201}, now) === score(fast, now), 'Bandwidth expires');
const nodes = ['fast', 'slow'];
let bandwidth_samples = { fast, slow: {...slow, speed: 1, speed_checked: now} };
assert(length(eligibleNodes(bandwidth_samples, nodes, 'slow', now)) === 2, 'Failed download must not exclude unmeasured candidates');
state = { fallback: 'fallback', switched: now - 200 };
for (let i = 0; i < 2; i++)
	assert(!decide(state, bandwidth_samples, eligibleNodes(bandwidth_samples, nodes, 'slow', now), 'slow', now), 'Download failure still requires confirmation');
assert(decide(state, bandwidth_samples, eligibleNodes(bandwidth_samples, nodes, 'slow', now), 'slow', now) === 'fast', 'Escape node with a failed download');
bandwidth_samples.slow = {...slow, speed: 1000000, speed_checked: now};
assert(length(eligibleNodes(bandwidth_samples, nodes, 'slow', now)) === 1, 'Healthy measured current compares measured peers');
assert(length(eligibleNodes(bandwidth_samples, nodes, 'fast', now)) === 2, 'Unmeasured current keeps unmeasured peers');
assert(length(eligibleNodes(bandwidth_samples, nodes, 'slow', now + 1200)) === 2, 'Expired download does not restrict candidates');
bandwidth_samples.fast = {...fast, speed: 2000000, speed_checked: now};
assert(length(eligibleNodes(bandwidth_samples, nodes, 'slow', now)) === 2, 'Fresh successful downloads compared together');
bandwidth_samples.slow = {...bandwidth_samples.slow, healthy: false, failures: 2};
delete bandwidth_samples.fast.speed;
delete bandwidth_samples.fast.speed_checked;
const recovery_nodes = eligibleNodes(bandwidth_samples, nodes, 'slow', now);
state = { fallback: 'fallback', switched: now - 10 };
assert(length(recovery_nodes) === 2 && decide(state, bandwidth_samples, recovery_nodes, 'slow', now) === 'fast', 'Outage recovery includes unmeasured healthy nodes');

/* A passing probe must not erase a real session timeout. */
let probed = observe(null, [360, 370, 380], now);
probed = observeSession(probed, true, now);
assert(probed.healthy && probed.failures === 0 && probed.session_failures === 1, 'Probe success keeps the session failure');
probed = observe(probed, [360, 370, 380], now + 60);
assert(probed.session_failures === 1, 'Another successful probe does not clear session failures');
state = { fallback: 'fallback', switched: now - 10 };
assert(!decide(state, { slow: probed, fast }, ['fast', 'slow'], 'slow', now + 60), 'One session cycle is held');
probed = observeSession(probed, true, now + 70);
assert(decide(state, { slow: probed, fast }, ['fast', 'slow'], 'slow', now + 70) === 'fast', 'Repeated session timeouts bypass cooldown');
probed = observeSession(probed, false, now + 80);
assert(probed.session_failures === 0, 'A clean cycle clears session failures');
assert(!decide({ fallback: 'fallback', switched: now - 10 }, { slow: {...probed, session_failures: 2, session_at: now - 181}, fast }, ['fast', 'slow'], 'slow', now), 'Stale session failure is not proof');
print('Smart selection scoring and switching passed\n');
