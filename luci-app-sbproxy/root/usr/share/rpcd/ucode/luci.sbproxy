'use strict';

import { lstat, open, popen, readfile, writefile } from 'fs';
import { cursor } from 'uci';
import { urlencode } from 'luci.http';
import { connect } from 'ubus';

import {
	SB_DIR, isBinary, isEmpty,
	RUN_DIR, parseDnsServerAddress, removeBlankAttrs, renderEndpoint, renderOutbound,
	renderNodeDomainResolver, resolveNodeDialFields, shellQuote
} from '/etc/sbproxy/scripts/sbproxy.uc';

function hasKernelModule(kmod) {
	return (system(sprintf('[ -e "/lib/modules/$(uname -r)"/%s ]', shellQuote(kmod))) === 0);
}

function runCommand(command) {
	const fd = popen(`${command} 2>&1`);
	if (!fd)
		return { code: 1, output: 'failed to execute command' };

	let output = '', line;
	while (true) {
		line = fd.read('line');
		if (line === null || line === '')
			break;
		output += line;
	}
	const code = fd.close();
	return { code: int(code) || 0, output };
}

function coreManagerCall(action, target, operation_id) {
	let command = `/usr/libexec/sbproxy-core-manager ${shellQuote(action)}`;
	if (target)
		command += ` ${shellQuote(target)}`;
	if (operation_id)
		command += ` ${shellQuote(operation_id)}`;
	const result = runCommand(command);
	let response = {
		code: result.code,
		output: result.output,
		assets: []
	};
	const booleans = [
		'automatic_rollback', 'busy', 'manager_supported', 'rollback_available',
		'rolled_back', 'service_running', 'upgraded'
	];
	const integers = [ 'overlay_available_kb', 'tmp_available_kb', 'result_code' ];

	for (let line in split(result.output || '', '\n')) {
		const pair = match(line, /^([^=]+)=(.*)$/);
		if (!pair)
			continue;
		const key = pair[1];
		const value = pair[2];
		if (key === 'asset') {
			const fields = split(value, '\t');
			if (length(fields) >= 6)
				push(response.assets, {
					filename: fields[0],
					package_version: fields[1],
					relation: fields[2],
					size: int(fields[3]) || 0,
					created_at: fields[4],
					sha256: fields[5]
				});
		} else if (index(booleans, key) !== -1) {
			response[key] = value === '1';
		} else if (index(integers, key) !== -1) {
			response[key] = int(value) || 0;
		} else if (key === 'tags' || key === 'required_tags') {
			response[key] = value ? split(value, ',') : [];
		} else {
			response[key] = value || null;
		}
	}

	return response;
}

function tailscaleAPICommand(arguments) {
	const sbpuci = cursor();
	sbpuci.load('sbproxy');
	const port = sbpuci.get('sbproxy', 'infra', 'tailscale_api_port');
	if (!port || !match(port, /^[0-9]+$/))
		return null;

	let command = `/usr/bin/sing-box api --url ${shellQuote(`http://127.0.0.1:${port}`)}`;
	for (let argument in arguments)
		command += ` ${shellQuote(argument)}`;
	return command;
}

function parseTailscaleStatus(output) {
	let status = {
		backend_state: null,
		network_name: null,
		auth_url: null
	};

	for (let line in split(output || '', '\n')) {
		let parsed = match(line, /^\s*State:\s*(\S.*)$/);
		if (parsed) {
			status.backend_state = trim(parsed[1]);
			continue;
		}
		parsed = match(line, /^\s*Network:\s*(\S.*)$/);
		if (parsed) {
			status.network_name = trim(parsed[1]);
			continue;
		}
		parsed = match(line, /^\s*Log in:\s*(https?:\/\/\S+)\s*$/);
		if (parsed)
			status.auth_url = parsed[1];
	}

	return status;
}

function parseTailscaleExitNodes(output) {
	let nodes = [];
	for (let line in split(output || '', '\n')) {
		const fields = split(trim(line), '\t');
		if (length(fields) < 4)
			continue;
		const name = trim(fields[0]);
		const address = trim(fields[1]);
		if (!name || !address)
			continue;
		push(nodes, {
			name,
			address,
			online: lc(trim(fields[2])) === 'yes',
			selected: lc(trim(fields[3])) === 'selected'
		});
	}
	return nodes;
}

function parseTailscalePeerRoutes(output) {
	let routes = [], seen = {};
	for (let line in split(output || '', '\n')) {
		const fields = split(trim(line), '\t');
		if (length(fields) < 4)
			continue;
		const route = trim(fields[0]);
		const name = trim(fields[1]);
		const address = trim(fields[2]);
		if (!route || !name || !address || index(route, '/') < 0 ||
		    route === '0.0.0.0/0' || route === '::/0' || seen[route])
			continue;
		seen[route] = true;
		push(routes, {
			route,
			name,
			address,
			online: lc(trim(fields[3])) === 'yes'
		});
	}
	return routes;
}

function parseTailscalePeers(output) {
	let peers = [], is_self = true;
	for (let line in split(output || '', '\n')) {
		const fields = split(trim(line), '\t');
		if (length(fields) < 3)
			continue;
		const dns_name = trim(fields[0]);
		const address = trim(fields[1]);
		if (!dns_name || !address)
			continue;
		push(peers, {
			dns_name,
			address,
			online: lc(trim(fields[2])) === 'yes',
			self: is_self
		});
		is_self = false;
	}
	return peers;
}

function parseTailscalePeerDetails(output) {
	let peer = {
		dns_name: null,
		host_name: null,
		stable_id: null,
		user: null,
		os: null,
		ips: [],
		online: null,
		active: null,
		expired: null,
		sharee_node: null,
		exit_node: null,
		rx_bytes: null,
		tx_bytes: null,
		key_expiry: null,
		last_seen: null,
		ssh_host_keys: null
	};
	for (let line in split(output || '', '\n')) {
		const parsed = match(line, /^\s*([^:]+):\s*(.*)$/);
		if (!parsed)
			continue;
		const key = lc(trim(parsed[1]));
		const raw_value = trim(parsed[2]);
		const value = raw_value === '-' ? null : raw_value;
		switch (key) {
		case 'dns name':
			peer.dns_name = value;
			break;
		case 'host name':
			peer.host_name = value;
			break;
		case 'stable id':
			peer.stable_id = value;
			break;
		case 'user':
			peer.user = value;
			break;
		case 'os':
			peer.os = value;
			break;
		case 'ips':
			for (let address in split(raw_value, ',')) {
				address = trim(address);
				if (address)
					push(peer.ips, address);
			}
			break;
		case 'online':
			peer.online = lc(raw_value) === 'yes';
			break;
		case 'active':
			peer.active = lc(raw_value) === 'yes';
			break;
		case 'expired':
			peer.expired = lc(raw_value) === 'yes';
			break;
		case 'sharee node':
			peer.sharee_node = lc(raw_value) === 'yes';
			break;
		case 'exit node':
			peer.exit_node = value;
			break;
		case 'rx':
			peer.rx_bytes = match(raw_value, /^\d+$/) ? int(raw_value) : null;
			break;
		case 'tx':
			peer.tx_bytes = match(raw_value, /^\d+$/) ? int(raw_value) : null;
			break;
		case 'key expiry':
			peer.key_expiry = value;
			break;
		case 'last seen':
			peer.last_seen = value;
			break;
		case 'ssh host keys':
			peer.ssh_host_keys = value;
			break;
		}
	}
	return peer;
}

function parseTailscaleSystemRoutes(output, family) {
	let routes = [];
	try {
		const entries = json(output || '[]');
		for (let route in ((type(entries) === 'array') ? entries : [])) {
			const destination = route?.dst || (family === 'IPv6' ? '::/0' : '0.0.0.0/0');
			push(routes, {
				family,
				destination,
				device: route?.dev || null,
				gateway: route?.gateway || null,
				metric: route?.metric || null,
				protocol: route?.protocol || null
			});
		}
	} catch (e) {}
	return routes;
}

function parseTailscalePolicyRules(output, family) {
	let rules = [];
	try {
		const entries = json(output || '[]');
		for (let rule in ((type(entries) === 'array') ? entries : [])) {
			if (`${rule?.table}` !== '52')
				continue;
			push(rules, {
				family,
				priority: rule?.priority || null,
				source: rule?.src || 'all',
				destination: rule?.dst ? `${rule.dst}${rule.dstlen ? `/${rule.dstlen}` : ''}` : 'all',
				fwmark: rule?.fwmark || null,
				table: 52
			});
		}
	} catch (e) {}
	return rules;
}

function tailscaleSystemRoutingStatus() {
	let status = { available: true, routes: [], rules: [] };
	for (let family in [ '-4', '-6' ]) {
		const name = family === '-6' ? 'IPv6' : 'IPv4';
		const route_result = runCommand(`/sbin/ip ${family} -j route show table 52`);
		const rule_result = runCommand(`/sbin/ip ${family} -j rule show`);
		if (route_result.code !== 0 || rule_result.code !== 0)
			status.available = false;
		if (route_result.code === 0)
			for (let route in parseTailscaleSystemRoutes(route_result.output, name))
				push(status.routes, route);
		if (rule_result.code === 0)
			for (let rule in parseTailscalePolicyRules(rule_result.output, name))
				push(status.rules, rule);
	}
	return status;
}

function tailscaleInterfaceStatus(interface_name) {
	let status = {
		name: interface_name,
		present: false,
		up: false,
		operstate: null,
		ipv4: [],
		ipv6: [],
		mtu: null,
		rx_bytes: null,
		tx_bytes: null
	};
	if (!interface_name || length(interface_name) > 15 ||
	    !match(interface_name, /^[A-Za-z0-9_.-]+$/))
		return status;

	const sysfs = `/sys/class/net/${interface_name}`;
	if (!lstat(sysfs))
		return status;

	status.present = true;
	status.operstate = trim(readfile(`${sysfs}/operstate`) || '') || null;
	const mtu = trim(readfile(`${sysfs}/mtu`) || '');
	const rx_bytes = trim(readfile(`${sysfs}/statistics/rx_bytes`) || '');
	const tx_bytes = trim(readfile(`${sysfs}/statistics/tx_bytes`) || '');
	if (match(mtu, /^\d+$/))
		status.mtu = int(mtu);
	if (match(rx_bytes, /^\d+$/))
		status.rx_bytes = int(rx_bytes);
	if (match(tx_bytes, /^\d+$/))
		status.tx_bytes = int(tx_bytes);

	const result = runCommand(`/sbin/ip -j address show dev ${shellQuote(interface_name)}`);
	if (result.code !== 0)
		return status;
	try {
		const devices = json(result.output || '[]');
		const device = type(devices) === 'array' ? devices[0] : null;
		for (let flag in ((type(device?.flags) === 'array') ? device.flags : [])) {
			if (flag === 'UP')
				status.up = true;
		}
		for (let address in ((type(device?.addr_info) === 'array') ? device.addr_info : [])) {
			if (!address?.local || !address?.prefixlen || address.scope === 'link')
				continue;
			const cidr = `${address.local}/${address.prefixlen}`;
			if (address.family === 'inet')
				push(status.ipv4, cidr);
			else if (address.family === 'inet6')
				push(status.ipv6, cidr);
		}
	} catch (e) {}
	return status;
}

const RESOURCES = {
	geoip_cn: {
		source: 'https://cdn.jsdelivr.net/gh/SagerNet/sing-geoip@rule-set/geoip-cn.srs',
		version: `${SB_DIR}/resources/geoip_cn.ver`
	},
	geosite_cn: {
		source: 'https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set-unstable/geosite-cn.srs',
		version: `${SB_DIR}/resources/geosite_cn.ver`
	},
	dashboard: {
		source: 'https://codeload.github.com/SagerNet/sing-box-dashboard/zip/refs/heads/gh-pages',
		version: `${SB_DIR}/dashboard/dashboard.ver`
	}
};
const CONNECTION_SITES = {
	baidu: 'https://www.baidu.com/',
	bilibili: 'https://www.bilibili.com/',
	jd: 'https://www.jd.com/',
	google: 'https://www.google.com/',
	github: 'https://github.com/',
	youtube: 'https://www.youtube.com/'
};

const methods = {
	ingress_status: {
		call: function() {
			const result = runCommand('ucode /etc/sbproxy/scripts/ingress_status.uc');
			try { return json(result.output); }
			catch(e) { return { error: 'Unable to read ingress policy status' }; }
		}
	},
	core_status: {
		call: function() {
			return coreManagerCall('status');
		}
	},

	core_check_update: {
		call: function() {
			return coreManagerCall('check');
		}
	},

	plugin_check_update: {
		call: function() {
			return coreManagerCall('plugin-check');
		}
	},

	plugin_upgrade: {
		args: { target: 'target', operation_id: '' },
		call: function(req) {
			const target = trim(req.args?.target || '');
			const id = trim(req.args?.operation_id || '');
			if (!match(target, /^luci-app-sbproxy-[0-9]+\.[0-9]+\.[0-9]+-r[1-9][0-9]*\.apk$/) ||
			    !match(id, /^[a-f0-9]{32}$/))
				return { code: 2, error_code: 'invalid_target' };
			return coreManagerCall('start-plugin-upgrade', target, id);
		}
	},

	core_operation_status: {
		args: { operation_id: '' },
		call: function(req) {
			const id = trim(req.args?.operation_id || '');
			if (id && !match(id, /^[a-f0-9]{32}$/))
				return { code: 2, error_code: 'invalid_target' };
			return coreManagerCall('operation', id);
		}
	},

	core_upgrade: {
		args: { target: 'target', operation_id: '' },
		call: function(req) {
			const target = trim(req.args?.target || '');
			if (!match(target, /^sing-box-[0-9]+\.[0-9]+\.[0-9]+(-alpha\.[1-9][0-9]*)?(-r[1-9][0-9]*)?\.apk$/))
				return { code: 2, error_code: 'invalid_target', error: 'Invalid core package selection.' };
			const id = trim(req.args?.operation_id || '');
			if (!match(id, /^[a-f0-9]{32}$/))
				return { code: 2, error_code: 'invalid_target' };
			return coreManagerCall('start-upgrade', target, id);
		}
	},

	core_rollback: {
		args: { target: 'target', operation_id: '' },
		call: function(req) {
			const target = trim(req.args?.target || '');
			if (!match(target, /^sing-box-[0-9]+\.[0-9]+\.[0-9]+(-alpha\.[1-9][0-9]*)?(-r[1-9][0-9]*)?\.apk$/))
				return { code: 2, error_code: 'invalid_target', error: 'Invalid core package selection.' };
			const id = trim(req.args?.operation_id || '');
			if (!match(id, /^[a-f0-9]{32}$/))
				return { code: 2, error_code: 'invalid_target' };
			return coreManagerCall('start-rollback', target, id);
		}
	},

	tailscale_status: {
		call: function() {
			const sbpuci = cursor();
			sbpuci.load('sbproxy');
			const enabled = sbpuci.get('sbproxy', 'tailscale', 'enabled') === '1';
			const standalone_installed = !!lstat('/etc/init.d/tailscale');
			const interface_name = sbpuci.get('sbproxy', 'tailscale', 'system_interface_name') ||
			      'tailscale0';
			const interface_status = tailscaleInterfaceStatus(interface_name);
			const routing_status = tailscaleSystemRoutingStatus();
			if (!enabled)
				return {
					enabled: false,
					standalone_installed,
					running: false,
					backend_state: 'Disabled',
					network_name: null,
					auth_url: null,
					exit_nodes: [],
					peer_routes: [],
					peer_routes_available: null,
					peer_routes_error: null,
					peers_available: null,
					peers_error: null,
					peers: [],
					self: null,
					interface: interface_status,
					system_routing: routing_status,
					code: 0,
					output: 'Disabled'
				};
			const command = tailscaleAPICommand([ 'tailscale', 'status' ]);
			if (!command)
				return {
					enabled,
					standalone_installed,
					running: false,
					backend_state: null,
					network_name: null,
					auth_url: null,
					exit_nodes: [],
					peer_routes: [],
					peer_routes_available: null,
					peer_routes_error: null,
					peers_available: null,
					peers_error: null,
					peers: [],
					self: null,
					interface: interface_status,
					system_routing: routing_status,
					code: 1,
					output: 'API port is unavailable.'
				};
			const result = runCommand(command);
			const status = parseTailscaleStatus(result.output);
			let exit_nodes = [], peer_routes = [], peers = [], self = null,
			    peer_routes_available = null, peer_routes_error = null,
			    peers_available = null, peers_error = null;
			if (result.code === 0) {
				const peer_command = tailscaleAPICommand([ 'tailscale', 'peer', 'list' ]);
				if (peer_command) {
					const peer_result = runCommand(peer_command);
					if (peer_result.code === 0) {
						peers_available = true;
						peers = parseTailscalePeers(peer_result.output);
						const self_peer = peers[0];
						const self_command = self_peer?.self ?
							tailscaleAPICommand([ 'tailscale', 'peer', 'show', self_peer.address ]) : null;
						if (self_command) {
							const self_result = runCommand(self_command);
							if (self_result.code === 0)
								self = parseTailscalePeerDetails(self_result.output);
						}
					} else {
						peers_available = false;
						peers_error = trim(replace(peer_result.output || '',
							/\x1b\[[0-9;]*m/g, '')) || 'peer status query failed';
					}
				}
				const exit_command = tailscaleAPICommand([ 'tailscale', 'exit-node', 'list' ]);
				if (exit_command) {
					const exit_result = runCommand(exit_command);
					if (exit_result.code === 0)
						exit_nodes = parseTailscaleExitNodes(exit_result.output);
				}
				const route_command = tailscaleAPICommand([ 'tailscale', 'route', 'list' ]);
				if (route_command) {
					const route_result = runCommand(route_command);
					if (route_result.code === 0) {
						peer_routes = parseTailscalePeerRoutes(route_result.output);
						peer_routes_available = true;
					} else {
						peer_routes_available = false;
						peer_routes_error = trim(replace(route_result.output || '',
							/\x1b\[[0-9;]*m/g, '')) ||
							'peer route query failed';
					}
				}
			}
			return {
				enabled,
				standalone_installed,
				running: enabled && result.code === 0 && status.backend_state === 'Running',
				backend_state: status.backend_state,
				network_name: status.network_name,
				auth_url: status.auth_url,
				exit_nodes,
				peer_routes,
				peer_routes_available,
				peer_routes_error,
				peers_available,
				peers_error,
				peers,
				self,
				interface: interface_status,
				system_routing: routing_status,
				code: result.code,
				output: result.output
			};
		}
	},

	tailscale_peer_details: {
		args: { target: 'target' },
		call: function(req) {
			const target = trim(req.args?.target || '');
			if (!target || length(target) > 253 || !match(target, /^[A-Za-z0-9_.:-]+$/))
				return { code: 2, output: 'invalid Tailscale peer', peer: null };
			const command = tailscaleAPICommand([ 'tailscale', 'peer', 'show', target ]);
			if (!command)
				return { code: 1, output: 'API port is unavailable.', peer: null };
			const result = runCommand(command);
			return {
				code: result.code,
				output: result.output,
				peer: result.code === 0 ? parseTailscalePeerDetails(result.output) : null
			};
		}
	},

	tailscale_ping: {
		args: { target: 'target' },
		call: function(req) {
			const target = trim(req.args?.target || '');
			if (!target || length(target) > 253 || !match(target, /^[A-Za-z0-9_.:-]+$/))
				return { code: 2, output: 'invalid Tailscale peer' };
			const command = tailscaleAPICommand([ 'tailscale', 'ping', target ]);
			return command ? runCommand(command) : { code: 1, output: 'API port is unavailable.' };
		}
	},

	tailscale_logout: {
		call: function() {
			const command = tailscaleAPICommand([ 'tailscale', 'logout' ]);
			return command ? runCommand(command) : { code: 1, output: 'API port is unavailable.' };
		}
	},

	acllist_read: {
		args: { type: 'type' },
		call: function(req) {
			if (index(['direct_list', 'proxy_list'], req.args?.type) === -1)
				return { content: null, error: 'illegal type' };

			const filecontent = readfile(`${SB_DIR}/resources/${req.args?.type}.txt`);
			return { content: filecontent };
		}
	},
	acllist_write: {
		args: { type: 'type', content: 'content' },
		call: function(req) {
			if (index(['direct_list', 'proxy_list'], req.args?.type) === -1)
				return { result: false, error: 'illegal type' };

			const file = `${SB_DIR}/resources/${req.args?.type}.txt`;
			let content = (type(req.args?.content) === 'string') ? req.args.content : '';

			/* Sanitize content */
			if (content) {
				content = trim(content);
				content = replace(content, /\r\n?/g, '\n');
				if (!match(content, /\n$/))
					content += '\n';
			}

			system(`mkdir -p ${SB_DIR}/resources`);
			if (writefile(file, content) === null)
				return { result: false, error: 'failed to write domain list' };

			return { result: true };
		}
	},

	certificate_write: {
		args: { filename: 'filename' },
		call: function(req) {
			const writeCertificate = (filename, kind) => {
				const tmpcert = '/tmp/sbproxy_certificate.tmp';
				const filestat = lstat(tmpcert);

				if (!filestat || filestat.type !== 'file' || filestat.size <= 0) {
					system(`/bin/rm -f ${shellQuote(tmpcert)}`);
					return { result: false, error: 'empty certificate file' };
				}

				let filecontent = readfile(tmpcert);
				if (isBinary(filecontent)) {
					system(`/bin/rm -f ${shellQuote(tmpcert)}`);
					return { result: false, error: 'illegal file type: binary' };
				}

				const allowed = (kind === 'private') ?
				      [ 'RSA PRIVATE KEY', 'EC PRIVATE KEY', 'PRIVATE KEY' ] :
				      ((kind === 'ech') ? [ 'ECH CONFIGS' ] : [ 'CERTIFICATE' ]),
				      multiple = kind === 'certificate',
				      normalized = replace(trim(filecontent), /\r\n?/g, '\n'),
				      lines = split(normalized, '\n');
				let current, payload = '', blocks = 0, valid = true;

				for (let line in lines) {
					if (!current) {
						if (!line)
							continue;

						const begin = match(line, /^-----BEGIN (.+)-----$/);
						if (!begin || !(begin[1] in allowed)) {
							valid = false;
							break;
						}

						current = begin[1];
						payload = '';
						continue;
					}

					if (line === `-----END ${current}-----`) {
						let decoded;
						try {
							decoded = payload ? b64dec(payload) : null;
						} catch (e) {
							decoded = null;
						}

						if (!decoded) {
							valid = false;
							break;
						}

						current = null;
						payload = '';
						blocks++;
						continue;
					}

					if (!line || match(line, /^-----/) || !match(line, /^[A-Za-z0-9+\/]+={0,2}$/)) {
						valid = false;
						break;
					}
					payload += line;
				}

				if (!valid || current || blocks === 0 || (!multiple && blocks !== 1)) {
					system(`/bin/rm -f ${shellQuote(tmpcert)}`);
					return { result: false, error: 'this does not look like a correct PEM file' };
				}

				/* Sanitize certificate */
				filecontent = trim(filecontent);
				filecontent = replace(filecontent, /\r\n?/g, '\n');
				if (!match(filecontent, /\n$/))
					filecontent += '\n';

				const certfile = `${SB_DIR}/certs/${filename}.pem`;
				system(`/bin/mkdir -p ${shellQuote(SB_DIR + '/certs')}`);
				if (writefile(certfile, filecontent) === null) {
					system(`/bin/rm -f ${shellQuote(tmpcert)}`);
					return { result: false, error: 'failed to write certificate file' };
				}
				if (kind === 'private' && system(`/bin/chmod 600 ${shellQuote(certfile)}`) !== 0) {
					system(`/bin/rm -f ${shellQuote(tmpcert)} ${shellQuote(certfile)}`);
					return { result: false, error: 'failed to protect private key file' };
				}
				system(`/bin/rm -f ${shellQuote(tmpcert)}`);

				return { result: true };
			};

			const filename = req.args?.filename;
			switch (filename) {
			case 'client_ca':
			case 'server_publickey':
				return writeCertificate(filename, 'certificate');
			case 'client_ech_conf':
				return writeCertificate(filename, 'ech');
			case 'server_privatekey':
				return writeCertificate(filename, 'private');
			default:
				return { result: false, error: 'illegal certificate filename' };
			}
		}
	},

	connection_check: {
		args: { site: 'site' },
		call: function(req) {
			const requested_site = req.args?.site;
			if (requested_site !== 'all' && !CONNECTION_SITES[requested_site])
				return { result: false, error: 'illegal site' };

			const uci = cursor();
			uci.load('sbproxy');
			const mixed_port = int(uci.get('sbproxy', 'infra', 'mixed_port') || 5330);
			if (mixed_port < 1 || mixed_port > 65535)
				return { result: false, error: 'invalid mixed proxy port' };

			/* Route probes through SBProxy to match normal client traffic. */
			const proxy_url = sprintf('http://127.0.0.1:%d', mixed_port);
			const sites = (requested_site === 'all') ? keys(CONNECTION_SITES) : [ requested_site ];
			let commands = [];
			for (let site in sites) {
				push(commands, sprintf(
					'/usr/bin/curl --location --silent --output /dev/null --user-agent %s --proxy %s --noproxy %s --connect-timeout 5 --max-time 9 --write-out %s %s',
					shellQuote('Mozilla/5.0'),
					shellQuote(proxy_url),
					shellQuote(''),
					shellQuote(sprintf('%s\\t%%{http_code}\\t%%{time_appconnect}\\t%%{time_total}\\n', site)),
					shellQuote(CONNECTION_SITES[site])
				));
			}

			const fd = popen(sprintf('(%s & wait) 2>"/dev/null"', join(' & ', commands)));
			if (!fd)
				return { result: false, error: 'failed to execute connection test' };

			let payload = '', line;
			while (true) {
				line = fd.read('line');
				if (line === null || line === '')
					break;
				payload += line;
			}
			fd.close();

			const responses = {};
			const curlTimeMs = (value) => {
				const parts = split(value || '0', '.');
				const fraction = ((parts[1] || '') + '000');
				return int(parts[0] || '0') * 1000 + int(substr(fraction, 0, 3));
			};

			for (let response in split(trim(payload), /[\r\n]+/)) {
				const fields = split(response, '\t');
				if (length(fields) !== 4 || !CONNECTION_SITES[fields[0]])
					continue;

				const latency_ms = curlTimeMs(fields[2]);
				const total_ms = curlTimeMs(fields[3]);
				const http_code = int(fields[1] || '0');
				responses[fields[0]] = {
					site: fields[0],
					result: http_code >= 100 && http_code <= 599,
					latency_ms,
					timed_out: http_code === 0 && total_ms >= 8900
				};
			}

			let results = [];
			for (let site in sites)
				push(results, responses[site] || { site, result: false, latency_ms: 0, timed_out: false });

			return { results };
		}
	},

	current_node_get: {
		call: function() {
			const uci = cursor();
			uci.load('sbproxy');
			const routing_mode = uci.get('sbproxy', 'config', 'routing_mode') || 'bypass_mainland_china';
			if (routing_mode === 'disabled')
				return { mode: 'disabled', proxy_enabled: false, active: null, error: null };
			if (routing_mode === 'custom')
				return { mode: 'custom', proxy_enabled: !isEmpty(uci.get('sbproxy', 'routing', 'default_outbound')), active: null, error: null };

			const formatNode = (section_id, fallback_name) => {
				if (!section_id || section_id in ['nil', 'same'])
					return { id: section_id, label: fallback_name || section_id, type: null };

				const section = uci.get_all('sbproxy', section_id);
				if (!section || section['.type'] !== 'node')
					return { id: section_id, label: fallback_name || section_id, type: null };

				const address = trim(section.address || '');
				const port = trim(section.port || '');
				const label = trim(section.label || '') || ((address && port) ? `${address}:${port}` : section_id);
				return {
					id: section_id,
					label,
					type: section.type || null
				};
			};

			const main_node = trim(uci.get('sbproxy', 'config', 'main_node') || 'nil');
			if (main_node !== 'urltest')
				return {
					mode: main_node,
					proxy_enabled: main_node !== 'nil',
					active: formatNode(main_node, (main_node === 'nil') ? 'Disable' : null),
					error: null
				};

			const clash_api_port = int(uci.get('sbproxy', 'infra', 'clash_api_port'));
			if (!clash_api_port)
				return {
					mode: 'urltest',
					active: { id: 'urltest', label: 'URLTest', type: 'urltest' },
					error: 'clash_api_unavailable'
				};
			const fd = popen(`/usr/bin/curl -fsS --connect-timeout 1 --max-time 2 http://127.0.0.1:${clash_api_port}/proxies/main-out 2>"/dev/null"`);
			if (!fd)
				return {
					mode: 'urltest',
					active: { id: 'urltest', label: 'URLTest', type: 'urltest' },
					error: 'clash_api_unavailable'
				};

			let payload = '', line;
			for (line = fd.read('line'); length(line); line = fd.read('line'))
				payload += line;
			fd.close();

			let data = null;
			try {
				data = json(payload);
			} catch (e) {}

			let tag = trim(data?.now || '');
			const smart = uci.get('sbproxy', 'config', 'main_urltest_smart') === '1';
			/* Resolve the initial URLTest fallback to its leaf node for display. */
			if (smart && tag) {
				let plan = null;
				try { plan = json(readfile(RUN_DIR + '/sing-box-c.json.smart.json')); } catch (e) {}
				const group = filter(plan?.groups || [], (g) => g.tag === 'main-out')[0];
				if (group && tag === group.fallback) {
					const result = runCommand('/usr/bin/curl --noproxy ' + shellQuote('*') +
						' -fsS --connect-timeout 1 --max-time 2 ' +
						shellQuote(`http://127.0.0.1:${clash_api_port}/proxies/` + urlencode(tag)));
					try { tag = trim(json(result.output)?.now || tag); } catch (e) {}
				}
			}
			if (!tag)
				return {
					mode: 'urltest',
					active: { id: 'urltest', label: 'URLTest', type: 'urltest' },
					error: 'missing_current_proxy'
				};

			const matched = match(tag, /^cfg-(.*)-out$/);
			const section_id = matched ? matched[1] : tag;

			return {
				mode: 'urltest',
				smart,
				active: formatNode(section_id, tag),
				error: null
			};
		}
	},

	node_latency_test: {
		args: { nodes: [] },
		call: function(req) {
			const error_codes = {
				invalid_node: 'invalid_node',
				invalid_outbound: 'invalid_outbound',
				invalid_routing_context: 'invalid_routing_context',
				runtime_prepare_failed: 'runtime_prepare_failed',
				runtime_launch_failed: 'runtime_launch_failed',
				runtime_timeout: 'runtime_timeout',
				delay_timeout: 'delay_timeout',
				delay_failed: 'delay_failed',
				backend_execution_failed: 'backend_execution_failed'
			};
			const probe_url_encoded = 'https%3A%2F%2Fcp.cloudflare.com%2Fgenerate_204';
			const delay_timeout_ms = 5000;
			const probe_parallelism = 16;
			const sbpuci = cursor();
			sbpuci.load('sbproxy');
			const mode = sbpuci.get('sbproxy', 'config', 'routing_mode') || 'bypass_mainland_china';
			const wan_dns = connect()?.call('network.interface', 'status', { interface: 'wan' })?.['dns-server']?.[0] ||
				(mode === 'global' ? '9.9.9.9' : '223.5.5.5');
			let china_dns = sbpuci.get('sbproxy', 'config', 'china_dns_server');
			if (!china_dns || china_dns === 'wan') china_dns = wan_dns;
			const reserved_controller_port = int(sbpuci.get('sbproxy', 'infra', 'clash_api_port')) || 0;

			const formatResult = (node, state, latency_ms, err) => ({
				node,
				state,
				latency_ms,
				measured_at: time(),
				error: err
			});

			const readCommand = (command) => {
				const fd = popen(command);
				if (!fd)
					return null;

				let payload = '', line;
				while (true) {
					line = fd.read('line');
					if (line === null || line === '')
						break;
					payload += line;
				}
				fd.close();
				return payload;
			};

			const getRuntimePid = (runtime_meta) => {
				const pid = trim(readfile(runtime_meta?.pid_path) || '');
				if (!match(pid, /^[0-9]+$/))
					return null;

				const cmdline = readfile(`/proc/${pid}/cmdline`) || '';
				if (index(cmdline, 'sing-box') === -1 || index(cmdline, runtime_meta.config_path) === -1)
					return null;

				return pid;
			};

			const buildProbeRuntime = (entries) => {
				const runtime_root = RUN_DIR + '/latency-test';
				const session_id = sprintf('%d-%d', time(), int(readfile('/proc/uptime') || '0'));
				const session_dir = `${runtime_root}/${session_id}`;
				const config_path = `${session_dir}/sing-box.json`;
				const pid_path = `${session_dir}/sing-box.pid`;
				const port_output = readCommand(sprintf(
					'/usr/libexec/sbproxy-random-port %s 2>"/dev/null"',
					shellQuote(reserved_controller_port)
				));
				const controller_port = int(trim(port_output || ''));
				if (controller_port <= 0 || controller_port > 65535)
					return { error: 'failed to allocate temporary controller port' };

				const config = {
					log: { disabled: true },
					dns: {
						servers: [
							{ type: 'udp', tag: 'default-dns', server: wan_dns },
							{ type: 'local', tag: 'system-dns' },
							...(mode === 'bypass_mainland_china' ? [
								{
									tag: 'china-dns',
									domain_resolver: { server: 'default-dns', strategy: 'prefer_ipv6' },
									...parseDnsServerAddress(china_dns)
								}
							] : [])
						]
					},
					outbounds: [{ type: 'direct', tag: 'direct-out' }],
					endpoints: [],
					route: {
						final: 'direct-out',
						auto_detect_interface: true,
						default_domain_resolver: 'default-dns'
					},
					experimental: {
						clash_api: {
							external_controller: `127.0.0.1:${controller_port}`
						}
					}
				};

				for (let entry in entries) {
					push(entry.endpoint ? config.endpoints : config.outbounds, entry.outbound);
					const resolver = entry.outbound.domain_resolver?.server;
					if (resolver && index(resolver, 'cfg-') === 0 &&
					    !length(filter(config.dns.servers, (server) => server.tag === resolver))) {
						const id = replace(replace(resolver, /^cfg-/, ''), /-dns$/, '');
						const dns = sbpuci.get_all('sbproxy', id);
						const remote = dns.type in ['udp', 'tcp', 'tls', 'https', 'h3', 'quic'];
						push(config.dns.servers, {
							tag: resolver, type: dns.type,
							server: remote ? dns.server : null,
							server_port: remote ? int(dns.server_port) || null : null,
							interface: dns.type === 'dhcp' ? dns.interface : null,
							path: remote ? dns.path : null,
							headers: remote ? dns.headers : null,
							tls: remote && dns.tls_sni ? { enabled: true, server_name: dns.tls_sni } : null,
							domain_resolver: remote && (dns.domain_resolver || dns.domain_strategy) ? {
								server: dns.domain_resolver || 'default-dns',
								strategy: dns.domain_strategy
							} : null
						});
					}
				}

				if (system(`/bin/mkdir -p ${shellQuote(session_dir)}`) !== 0)
					return { error: 'failed to prepare temporary runtime directory' };

				if (!writefile(config_path, sprintf('%.J\n', removeBlankAttrs(config)))) {
					system(`/bin/rm -rf ${shellQuote(session_dir)}`);
					return { error: 'failed to write temporary sing-box config' };
				}

				return {
					session_dir,
					config_path,
					pid_path,
					controller_port,
					controller_url: `http://127.0.0.1:${controller_port}`
				};
			};

			const launchProbeRuntime = (runtime_meta) => {
				const launch_cmd = sprintf(
					'/usr/bin/sing-box run --config %s >/dev/null 2>&1 & pid=$!; printf "%%s\\n" "$pid" > %s; /bin/kill -0 "$pid" >/dev/null 2>&1',
					shellQuote(runtime_meta.config_path),
					shellQuote(runtime_meta.pid_path)
				);

				return system(`/bin/sh -c ${shellQuote(launch_cmd)}`) === 0;
			};

			const waitControllerReady = (runtime_meta) => {
				for (let i = 0; i < 10; i++) {
					if (getRuntimePid(runtime_meta)) {
						const payload = readCommand(`/usr/bin/curl -fsS --connect-timeout 1 --max-time 1 ${shellQuote(runtime_meta.controller_url + '/version')} 2>"/dev/null"`);
						if (trim(payload || ''))
							return true;
					}

					if (i + 1 < 10)
						sleep(200);
				}

				return false;
			};

			const cleanupProbeRuntime = (runtime_meta) => {
				const pid = getRuntimePid(runtime_meta);
				if (pid)
					system(`/bin/kill ${shellQuote(pid)} >/dev/null 2>&1`);

				system(`/bin/rm -rf ${shellQuote(runtime_meta.session_dir)}`);
			};

			const parseDelayResponse = (entry) => {
				const payload = readfile(entry.response_path);
				if (!trim(payload || '')) {
					return formatResult(entry.node, 'timeout', null, {
						code: error_codes.delay_timeout,
						message: sprintf('sing-box delay request timed out after %dms', delay_timeout_ms)
					});
				}

				let data;
				try {
					data = json(payload);
				} catch (e) {
					return formatResult(entry.node, 'error', null, {
						code: error_codes.delay_failed,
						message: 'sing-box delay response is not valid JSON'
					});
				}

				const delay_ms = int(data?.delay || '0');
				if (delay_ms > 0)
					return formatResult(entry.node, 'success', delay_ms, null);

				const message = trim(sprintf('%s', data?.message || data?.error || '')) || 'sing-box delay request failed';
				return formatResult(entry.node, match(message, /timeout/i) ? 'timeout' : 'error', null, {
					code: match(message, /timeout/i) ? error_codes.delay_timeout : error_codes.delay_failed,
					message
				});
			};

			const probeDelays = (runtime_meta, entries) => {
				let commands = [];
				for (let i = 0; i < length(entries); i++) {
					const entry = entries[i];
					const delay_endpoint = sprintf(
						'%s/proxies/%s/delay?url=%s&timeout=%d',
						runtime_meta.controller_url,
						entry.tag,
						probe_url_encoded,
						delay_timeout_ms
					);
					entry.response_path = `${runtime_meta.session_dir}/${entry.tag}.json`;
					push(commands, sprintf(
						'/usr/bin/curl -fsS --connect-timeout 1 --max-time %d -o %s %s 2>"/dev/null" &',
						int((delay_timeout_ms + 999) / 1000),
						shellQuote(entry.response_path),
						shellQuote(delay_endpoint)
					));

					if (length(commands) === probe_parallelism || i + 1 === length(entries)) {
						system(`/bin/sh -c ${shellQuote(join(' ', commands) + ' wait')}`);
						commands = [];
					}
				}

				for (let entry in entries)
					entry.result = parseDelayResponse(entry);
			};

			let requested_nodes = req.args?.nodes;
			if (type(requested_nodes) !== 'array')
				requested_nodes = requested_nodes ? [requested_nodes] : [];
			let slots = [], entries = [], seen = {};
			for (let index = 0; index < length(requested_nodes); index++) {
				const value = requested_nodes[index];
				const node = trim(sprintf('%s', value || ''));
				if (!node || seen[node])
					continue;
				seen[node] = true;

				const section = sbpuci.get_all('sbproxy', node);
				if (!section || section['.type'] !== 'node') {
					push(slots, {
						result: formatResult(node, 'error', null, {
							code: error_codes.invalid_node,
							message: 'node section does not exist or is not a node section'
						})
					});
					continue;
				}

				const resolved = resolveNodeDialFields(sbpuci, 'sbproxy', section);
				if (resolved.conflict) {
					push(slots, { result: formatResult(node, 'error', null, {
						code: error_codes.invalid_routing_context,
						message: sprintf('Conflicting legacy %s for node %s; set it on the node or split the node.',
							resolved.conflict, node)
					}) });
					continue;
				}
				const effective = resolved.node;
				if (effective.bind_interface &&
				    (!match(effective.bind_interface, /^[a-zA-Z0-9_.:-]{1,15}$/) ||
				     !lstat(`/sys/class/net/${effective.bind_interface}`))) {
					push(slots, { result: formatResult(node, 'error', null, {
						code: error_codes.invalid_outbound,
						message: sprintf('Bound interface %s does not exist.', effective.bind_interface)
					}) });
					continue;
				}
				const endpoint = effective.type === 'wireguard';
				const outbound = endpoint ? renderEndpoint(effective) : renderOutbound(effective);
				const tag = `probe-${length(entries)}`;
				if (!outbound || type(outbound) !== 'object' || !outbound.type) {
					push(slots, {
						result: formatResult(node, 'error', null, {
							code: error_codes.invalid_outbound,
							message: 'failed to render sing-box outbound for node'
						})
					});
					continue;
				}

				const fallback_resolver = mode === 'bypass_mainland_china' ? 'china-dns' :
					(mode === 'custom' ? sbpuci.get('sbproxy', 'routing', 'default_outbound_dns') || 'default-dns' : 'default-dns');
				const resolver_id = effective.domain_resolver ||
					(effective.domain_strategy ? fallback_resolver : null);
				if (resolver_id && !(resolver_id in ['default-dns', 'system-dns'])) {
					const dns = sbpuci.get_all('sbproxy', resolver_id);
					if (mode !== 'custom' || dns?.['.type'] !== 'dns_server' || dns.enabled !== '1' ||
					    dns.outbound && dns.outbound !== 'direct-out' ||
					    dns.domain_resolver && !(dns.domain_resolver in ['default-dns', 'system-dns'])) {
						push(slots, { result: formatResult(node, 'error', null, {
							code: error_codes.invalid_outbound,
							message: 'selected DNS server needs an unavailable proxy or chained resolver in isolated latency test'
						}) });
						continue;
					}
				}
				outbound.domain_resolver = renderNodeDomainResolver(effective, (name) =>
					name in ['default-dns', 'system-dns', 'china-dns'] ? name : `cfg-${name}-dns`,
					fallback_resolver);

				outbound.tag = tag;
				const entry = { node, tag, endpoint, outbound };
				push(slots, entry);
				push(entries, entry);
			}

			if (!length(entries))
				return { results: map(slots, (slot) => slot.result) };

			system(`/bin/mkdir -p ${shellQuote(RUN_DIR)}`);
			let lockfd = open(`${RUN_DIR}/latency-test.lock`, 'w', 0600);
			if (!lockfd || lockfd.lock('x') !== true) {
				lockfd?.close();
				for (let entry in entries)
					entry.result = formatResult(entry.node, 'error', null, {
						code: error_codes.runtime_prepare_failed,
						message: 'failed to lock temporary latency test runtime'
					});
				return { results: map(slots, (slot) => slot.result) };
			}

			const releaseLock = () => {
				lockfd.lock('u');
				lockfd.close();
				lockfd = null;
			};
			const setPendingError = (state, code, message) => {
				for (let entry in entries)
					if (!entry.result)
						entry.result = formatResult(entry.node, state, null, { code, message });
			};

			let runtime_meta = buildProbeRuntime(entries);
			if (runtime_meta?.error) {
				setPendingError('error', error_codes.runtime_prepare_failed, runtime_meta.error);
				releaseLock();
				return { results: map(slots, (slot) => slot.result) };
			}

			try {
				if (!launchProbeRuntime(runtime_meta))
					setPendingError('error', error_codes.runtime_launch_failed, 'failed to launch temporary sing-box runtime');
				else if (!waitControllerReady(runtime_meta))
					setPendingError('timeout', error_codes.runtime_timeout, 'temporary sing-box runtime did not become ready in time');
				else
					probeDelays(runtime_meta, entries);
			} catch (e) {
				setPendingError('error', error_codes.backend_execution_failed, 'unexpected backend error during latency test');
			}

			cleanupProbeRuntime(runtime_meta);
			releaseLock();

			return { results: map(slots, (slot) => slot.result || formatResult(slot.node, 'error', null, {
				code: error_codes.backend_execution_failed,
				message: 'latency test did not return a result'
			})) };
		}
	},

	log_clean: {
		args: { type: 'type' },
		call: function(req) {
			if (!(req.args?.type in ['sbproxy', 'sing-box-c', 'sing-box-s']))
				return { result: false, error: 'illegal type' };

			const filestat = lstat(`${RUN_DIR}/${req.args?.type}.log`);
			if (filestat && writefile(`${RUN_DIR}/${req.args?.type}.log`, '') === null)
				return { result: false, error: 'failed to clean log file' };
			return { result: true };
		}
	},

	singbox_generator: {
		args: { type: 'type', params: 'params' },
		call: function(req) {
			if (!(req.args?.type in ['ech-keypair', 'uuid', 'reality-keypair', 'vapid-keypair', 'wg-keypair']))
				return { result: false, error: 'illegal type' };

			const type = req.args?.type;
			const params = trim(req.args?.params || '');
			let result = {};

			const fd = popen(`/usr/bin/sing-box generate ${type}${params ? ' ' + shellQuote(params) : ''}`);
			if (fd) {
				let ech_cfg_set = false;
				let ech_key_set = false;

				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (type === 'uuid')
						result.uuid = trim(line);
					else if (type in ['reality-keypair', 'vapid-keypair', 'wg-keypair']) {
						let priv = match(trim(line), /PrivateKey: (.*)/);
						if (priv)
							result.private_key = priv[1];
						let pub = match(trim(line), /PublicKey: (.*)/);
						if (pub)
							result.public_key = pub[1];
					} else if (type in ['ech-keypair']) {
						if (trim(line) === '-----BEGIN ECH CONFIGS-----')
							ech_cfg_set = true;
						else if (trim(line) === '-----BEGIN ECH KEYS-----')
							ech_key_set = true;

						if (ech_cfg_set)
							result.ech_cfg = result.ech_cfg ? result.ech_cfg + '\n' + trim(line) : trim(line) ;
						if (ech_key_set)
							result.ech_key = result.ech_key ? result.ech_key + '\n' + trim(line) : trim(line) ;

						if (trim(line) === '-----END ECH CONFIGS-----')
							ech_cfg_set = false;
						else if (trim(line) === '-----END ECH KEYS-----')
							ech_key_set = false;
					}
				}

				fd.close();
			}

			return { result };
		}
	},

	singbox_get_features: {
		call: function() {
			let features = {};

			const fd = popen('/usr/bin/sing-box version');
			if (fd) {
				for (let line = fd.read('line'); length(line); line = fd.read('line')) {
					if (match(trim(line), /^sing-box version (.*)/))
						features.version = match(trim(line), /^sing-box version (.*)/)[1];

					let tags = match(trim(line), /^Tags: (.*)/);
					if (tags)
						for (let i in split(tags[1], ','))
							features[i] = true;
				}

				fd.close();
			}

			features.sbp_has_tcp_brutal = hasKernelModule('brutal.ko');

			return features;
		}
	},

	resources_get: {
		call: function() {
			let resources = [];
			for (let resource_type in keys(RESOURCES)) {
				const resource = RESOURCES[resource_type];
				const version = trim(readfile(resource.version) || '');
				push(resources, {
					type: resource_type,
					version: version || null,
					source: resource.source
				});
			}
			return { resources };
		}
	},
	resources_update: {
		call: function() {
			const sbpuci = cursor();
			sbpuci.load('sbproxy');
			const mixed_port = int(sbpuci.get('sbproxy', 'infra', 'mixed_port')) || 5330;
			const update_proxy = (sbpuci.get('sbproxy', 'subscription', 'update_via_proxy') === '1') ?
				`SBPROXY_UPDATE_PROXY=${shellQuote(`http://127.0.0.1:${mixed_port}`)} ` : '';
			const status = system(`${update_proxy}${SB_DIR}/scripts/update_resources.sh`);
			let update_result = {};
			if (status !== 2) {
				for (let line in split(trim(readfile(`${RUN_DIR}/update_resources.result`) || ''), '\n')) {
					const pair = match(line, /^([^=]+)=(.*)$/);
					if (pair)
						update_result[pair[1]] = pair[2];
				}
			}
			const core_updated = update_result.core_updated === '1';
			const dashboard_updated = update_result.dashboard_updated === '1';
			let apply_failed = false;
			if ((core_updated || dashboard_updated) && system('/etc/init.d/sbproxy running >/dev/null 2>&1') === 0)
				apply_failed = system('/etc/init.d/sbproxy reload >/dev/null 2>&1') !== 0;
			return {
				status,
				core_updated,
				dashboard_updated,
				apply_failed,
				updated: update_result.updated || null,
				failed: update_result.failed || null
			};
		}
	}
};

return { 'luci.sbproxy': methods };
