{
	"luci-app-sbproxy": {
		"description": "Grant access to SBProxy configuration",
		"read": {
			"file": {
				"/var/run/sbproxy/core-manager.log": [ "read" ],
				"/var/run/sbproxy/sbproxy.log": [ "read" ],
				"/var/run/sbproxy/sing-box-c.log": [ "read" ],
				"/var/run/sbproxy/sing-box-s.log": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ],
				"luci-rpc": [ "getHostHints" ],
				"luci.sbproxy": [
					"acllist_read", "connection_check", "core_check_update", "core_status", "core_operation_status", "plugin_check_update", "current_node_get", "ingress_status",
					"node_latency_test", "resources_get", "tailscale_peer_details", "tailscale_status",
					"singbox_generator", "singbox_get_features"
				]
			},
			"uci": [ "sbproxy", "tailscale", "wireless" ]
		},
		"write": {
			"file": {
				"/etc/sbproxy/scripts/update_subscriptions.sh": [ "exec" ],
				"/tmp/sbproxy_certificate.tmp": [ "write" ]
			},
			"ubus": {
				"luci.sbproxy": [
					"acllist_write", "certificate_write", "log_clean", "resources_update",
					"core_rollback", "core_upgrade", "plugin_upgrade", "tailscale_logout", "tailscale_ping"
				]
			},
			"uci": [ "sbproxy" ]
		}
	}
}
