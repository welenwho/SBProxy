
config sbproxy 'infra'
	option __warning 'DO NOT EDIT THIS SECTION, OR YOU ARE ON YOUR OWN!'
	option common_port '20,21,22,25,53,80,110,119,123,143,389,443,465,514,563,587,636,853,873,989,990,993,995,1194,1883,3306,3389,5222,5432,5671,5672,5900,6379,6443,6514,8080,8443,8883,9418'
	option mixed_port '5330'
	option dns_port '5333'
	option dns_redirect '1'
	option ntp_server 'nil'
	option udp_timeout '300'
	option tun_name 'singtun0'
	option tun_addr4 '172.19.0.1/30'
	option tun_addr6 'fdfe:dcba:9876::1/126'
	option tun_mtu '9000'
	option clash_api_port 'auto'
	option clash_api_port_initialized '0'
	option tailscale_api_port 'auto'
	option tailscale_api_port_initialized '0'

config sbproxy 'config'
	option main_node 'nil'
	#list main_urltest_subscriptions '<subscription URL MD5 without the #fragment>'
	option main_urltest_interval '60'
	option main_urltest_tolerance '75'
	option main_urltest_interrupt_exist_connections '0'
	option dns_server 'https://dns.quad9.net/dns-query'
	option china_dns_server 'https://dns.alidns.com/dns-query'
	option routing_mode 'disabled'
	option routing_port 'common'
	#list routing_port_extra '6002'
	option tun_route_exclude_tailscale '0'
	option ipv6_support '1'
	option log_level 'warn'
	option dashboard_enabled '0'
	option dashboard_port '9095'
	option dashboard_port_initialized '0'
	option dashboard_secret ''
	option dashboard_allow_tailscale '0'
	option dashboard_tls_tailscale '0'
	option dashboard_tls_name ''
	option memory_guard_enabled '0'
	option memory_guard_limit '256'
	option memory_guard_safety_margin '32'
	option dns_disable_cache '0'
	option dns_disable_cache_expire '0'
	option dns_optimistic '0'
	option dns_optimistic_timeout '259200'
	option dns_cache_capacity '1024'
	option dns_timeout '10'

config sbproxy 'control'
	option ingress_enabled '0'

config sbproxy 'routing'
	option tcpip_stack 'mixed'
	option udp_timeout '300'
	option bypass_cn_traffic '0'
	option default_outbound 'nil'
	option default_outbound_dns 'default-dns'
	# Routing-node URLTest sections may use list urltest_subscriptions; LuCI writes subscription URL hashes.

config sbproxy 'dns'
	option default_strategy 'prefer_ipv4'
	option default_server 'default-dns'
	option cache_file_store_dns '0'

config sbproxy 'subscription'
	option auto_update '0'
	option allow_insecure '0'
	option packet_encoding 'xudp'
	option user_agent 'sbproxy'
	option update_via_proxy '0'
	option auto_update_time '0 */6 * * *'
	option filter_nodes 'disabled'

config sbproxy 'tailscale'
	option enabled '0'
	option state_directory '/etc/sbproxy/tailscale'
	option system_interface_name 'tailscale0'
	option system_interface_mtu '1280'
	option listen_port '41641'
	option accept_routes '0'
	option magic_dns '1'
	option accept_search_domain '1'
	option advertise_exit_node '0'
	option exit_node_allow_lan_access '0'
	option disable_snat_subnet_routes '0'
	option relay_server_enabled '0'
	option relay_server_port '0'
	option derp_server_enabled '0'
	option derp_listen '::'
	option derp_port '8443'
	option derp_firewall '1'
	option derp_config_path '/etc/sbproxy/tailscale/derp.json'
	option derp_verify_tailscale '1'
	option derp_tls_mode 'manual'
	option derp_cert_path '/etc/sbproxy/certs/server_publickey.pem'
	option derp_key_path '/etc/sbproxy/certs/server_privatekey.pem'
	option derp_acme_provider 'letsencrypt'
	option derp_home ''
	option derp_stun_enabled '1'
	option derp_stun_listen '::'
	option derp_stun_port '3478'
	option ephemeral '0'
	option ssh_server '0'
	option ssh_disable_pty '0'
	option ssh_disable_sftp '0'
	option ssh_disable_forwarding '0'
	option taildrop_enabled '0'
	option taildrop_directory '/etc/sbproxy/tailscale/Taildrop'
	option udp_timeout '300'
	list access 'ts_ac_lan'
	list access 'ts_ac_wan'
	list access 'lan_ac_ts'
	#option hostname ''
	#option control_url 'https://controlplane.tailscale.com'
	#option auth_key ''
	#option auth_key_file '/etc/sbproxy/tailscale/auth.key'
	#list advertise_routes '192.168.1.0/24'
	#list advertise_tags 'tag:router'
	#option exit_node ''
	#list relay_server_static_endpoints '192.0.2.1:40000'
	#list derp_acme_domain 'derp.example.com'
	#option derp_acme_email 'admin@example.com'
	#list derp_verify_url 'https://control.example.com/verify'
	#list derp_mesh_server 'derp2.example.com:443'
	#option derp_mesh_psk ''
	#option derp_mesh_psk_file '/etc/sbproxy/tailscale/derp-mesh.key'
	#list subnet_routes '192.168.2.0/24'
	#list access 'ts_ac_lan'
	#list access 'lan_ac_ts'

config sbproxy 'server'
	option enabled '0'
	option log_level 'warn'
