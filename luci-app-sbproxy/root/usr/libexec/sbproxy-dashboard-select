#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Point /etc/sbproxy/dashboard at the selected dashboard files.
# sing-box serves one dashboard directory; every copy stays installed.

NAME="sbproxy"
SB_DIR="${SBPROXY_DIR:-/etc/$NAME}"
ACTIVE_DIR="${DASHBOARD_DIR:-$SB_DIR/dashboard}"
SINGBOX_DIR="$SB_DIR/dashboard-singbox"
YACD_DIR="$SB_DIR/dashboard-yacd"
METACUBEXD_DIR="$SB_DIR/dashboard-metacubexd"
CONFIG="${SBPROXY_CONFIG:-/etc/config/sbproxy}"

kind="singbox"
if [ -f "$CONFIG" ]; then
	configured="$(sed -n "s/^[[:space:]]*option[[:space:]][[:space:]]*dashboard_ui[[:space:]][[:space:]]*['\"]\\([^'\"]*\\)['\"].*/\\1/p" "$CONFIG" | head -n 1)"
	case "$configured" in
	singbox|yacd|metacubexd) kind="$configured" ;;
	esac
fi

# A previous install stored the official dashboard directly in the active path.
# Move it before choosing, so a saved selection is not ignored while that
# copy is still missing.
if [ -e "$ACTIVE_DIR" ] && [ ! -L "$ACTIVE_DIR" ] && [ -s "$ACTIVE_DIR/index.html" ] &&
   [ ! -s "$SINGBOX_DIR/index.html" ]; then
	mkdir -p "$SINGBOX_DIR" || exit 1
	find "$ACTIVE_DIR" -mindepth 1 -maxdepth 1 -exec mv {} "$SINGBOX_DIR/" \; || exit 1
	rmdir "$ACTIVE_DIR" 2>/dev/null || rm -rf "$ACTIVE_DIR"
fi

selected=""
case "$kind" in
singbox) [ -s "$SINGBOX_DIR/index.html" ] && selected="$SINGBOX_DIR" ;;
yacd) [ -s "$YACD_DIR/index.html" ] && selected="$YACD_DIR" ;;
metacubexd) [ -s "$METACUBEXD_DIR/index.html" ] && selected="$METACUBEXD_DIR" ;;
esac
# Only substitute when the official files are absent. A saved selection whose
# files are not downloaded yet must not silently keep serving another UI.
if [ -z "$selected" ] && [ ! -s "$SINGBOX_DIR/index.html" ]; then
	if [ -s "$YACD_DIR/index.html" ]; then
		selected="$YACD_DIR"
		kind="yacd"
	elif [ -s "$METACUBEXD_DIR/index.html" ]; then
		selected="$METACUBEXD_DIR"
		kind="metacubexd"
	fi
fi

if [ -z "$selected" ]; then
	# Drop a stale link so the previous UI is not served under the new choice.
	if [ -L "$ACTIVE_DIR" ]; then
		rm -f "$ACTIVE_DIR" || exit 1
	fi
	exit 0
fi

if [ -L "$ACTIVE_DIR" ]; then
	current="$(readlink "$ACTIVE_DIR" 2>/dev/null || true)"
	if [ "$current" != "$selected" ]; then
		rm -f "$ACTIVE_DIR" || exit 1
		ln -s "$selected" "$ACTIVE_DIR" || exit 1
	fi
elif [ -e "$ACTIVE_DIR" ]; then
	rm -rf "$ACTIVE_DIR" || exit 1
	ln -s "$selected" "$ACTIVE_DIR" || exit 1
else
	ln -s "$selected" "$ACTIVE_DIR" || exit 1
fi

# Clash dashboards otherwise try the browser machine at 127.0.0.1:9090.
# Always rewrite after the link is correct; an unchanged link used to skip this.
if [ "$kind" = "yacd" ] || [ "$kind" = "metacubexd" ]; then
	rewrite="${selected}/index.html.tmp.$$"
	sed 's|data-base-url="http://127.0.0.1:9090"|data-base-url=""|' "$selected/index.html" > "$rewrite" && \
		mv "$rewrite" "$selected/index.html"
fi
