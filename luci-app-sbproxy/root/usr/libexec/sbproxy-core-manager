#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-only

set -u

STATE_DIR="/etc/sbproxy/core"
ROLLBACK_APK="$STATE_DIR/rollback.apk"
ROLLBACK_META="$STATE_DIR/rollback.meta"
LOCK_FILE="/var/lock/sbproxy-core-manager.lock"
LOG_FILE="/var/run/sbproxy/core-manager.log"
# Kept outside the service runtime directory: restart/chown must not affect jobs.
JOB_DIR="/var/run/sbproxy-core-manager"
UPDATE_SERVICE="sbproxy-version-update"
REPOSITORY="welenwho/packages"
REQUIRED_TAGS="with_acme with_clash_api with_dhcp with_gvisor with_quic with_tailscale with_utls with_wireguard"
USER_AGENT="SBProxy-Core-Manager"
TAB="$(printf '\t')"

work_dir=''
assets_file=''
last_download_mode=''
expected_instances=''
expected_health=''
job_id=''
job_action=''
job_target=''

write_job() {
	job_state="$1"
	stage="$2"
	{
		emit operation_id "$job_id"
		emit operation_action "$job_action"
		emit operation_target "$job_target"
		emit operation_state "$job_state"
		emit operation_stage "$stage"
		if [ "$job_state" != running ]; then
			emit result_code "$job_exit"
			cat "$JOB_DIR/result"
		fi
	} > "$JOB_DIR/status.new" && mv -f "$JOB_DIR/status.new" "$JOB_DIR/status"
}

progress() {
	[ -n "$job_id" ] || return 0
	write_job running "$1"
}

finish_worker() {
	job_exit="$?"
	trap - EXIT
	cleanup
	case "$job_exit" in
	0) write_job succeeded done ;;
	130|143) write_job unknown interrupted ;;
	*) write_job failed done ;;
	esac
}

update_worker_running() {
	ubus call service list "{\"name\":\"$UPDATE_SERVICE\"}" 2>/dev/null |
		grep -Eq '"running"[[:space:]]*:[[:space:]]*true'
}

emit_operation() {
	requested_id="${1:-}"
	snapshot="$(cat "$JOB_DIR/status" 2>/dev/null || true)"
	if printf '%s\n' "$snapshot" | grep -qx 'operation_state=running'; then
		# Re-read while holding a free lock, so a newly submitted job cannot
		# race with the orphan check. A live worker keeps the lock unavailable.
		snapshot="$(
			exec 8>"$LOCK_FILE"
			if flock -n 8 && ! update_worker_running; then
				sed 's/^operation_state=running$/operation_state=unknown/' "$JOB_DIR/status"
			else
				cat "$JOB_DIR/status"
			fi
		)"
	fi
	if [ -z "$snapshot" ] || { [ -n "$requested_id" ] &&
	   ! printf '%s\n' "$snapshot" | grep -Fxq "operation_id=$requested_id"; }; then
		emit operation_state unknown
		return
	fi
	printf '%s\n' "$snapshot"
}

start_operation() {
	job_action="$1"
	job_target="$2"
	job_id="$3"
	printf '%s\n' "$job_id" | grep -Eq '^[a-f0-9]{32}$' || fail invalid_target 'Invalid operation ID.'
	case "$job_action" in
	plugin-upgrade) plugin_package_name "$job_target" ;;
	*) core_package_name "$job_target" ;;
	esac ||
		fail invalid_target 'Invalid core package selection.'
	exec 9>"$LOCK_FILE"
	flock -n 9 || fail operation_in_progress 'Another core operation is already in progress.'
	mkdir -p "$JOB_DIR" || fail temporary_directory_failed 'Unable to create the operation directory.'
	chmod 700 "$JOB_DIR"
	# The same request must never install twice, including after a lost reply.
	if grep -Fxq "operation_id=$job_id" "$JOB_DIR/status" 2>/dev/null; then
		cat "$JOB_DIR/status"
		return
	fi
	if grep -qx 'operation_state=running' "$JOB_DIR/status" 2>/dev/null && update_worker_running; then
		fail operation_in_progress 'Another update is already starting.'
	fi
	: > "$JOB_DIR/result"
	# A plugin upgrade replaces this very file. Execute an immutable snapshot
	# outside package-owned paths so shell reads and rollback survive it.
	cp "$0" "$JOB_DIR/worker" || fail temporary_directory_failed 'Unable to prepare the upgrade worker.'
	chmod 700 "$JOB_DIR/worker"
	write_job running queued || fail temporary_directory_failed 'Unable to save operation state.'
	# procd starts this task in its own service cgroup. setsid/nohup alone keep
	# the caller's cgroup, which rpcd/Dropbear restart can kill recursively.
	if ! ubus call service add "$(printf '{"name":"%s","instances":{"worker":{"command":["/bin/sh","%s","worker","%s","%s","%s"],"term_timeout":30}}}' \
		"$UPDATE_SERVICE" "$JOB_DIR/worker" "$job_action" "$job_target" "$job_id")" >/dev/null; then
		job_exit=1
		emit error_code worker_unavailable > "$JOB_DIR/result"
		write_job failed done
		fail worker_unavailable 'Unable to start the update service.'
	fi
	# The worker opens this lock itself; release the submission reservation.
	flock -u 9
	emit operation_id "$job_id"
	emit operation_action "$job_action"
	emit operation_target "$job_target"
	emit operation_state running
	emit operation_stage queued
}

cleanup() {
	[ -z "$work_dir" ] || rm -rf -- "$work_dir"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

emit() {
	key="$1"
	shift
	value="$(printf '%s' "$*" | tr '\n\t' '  ')"
	printf '%s=%s\n' "$key" "$value"
}

fail() {
	emit error_code "$1"
	shift
	emit error "$*"
	exit 1
}

log() {
	mkdir -p "$(dirname "$LOG_FILE")"
	printf '%s [CORE] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

package_version() {
	apk query --installed --fields version sing-box 2>/dev/null |
		sed -n 's/^Version:[[:space:]]*//p' | head -n 1
}

core_package_name() {
	printf '%s\n' "$1" | grep -Eq \
		'^sing-box-[0-9]+\.[0-9]+\.[0-9]+(-alpha\.[1-9][0-9]*)?(-r[1-9][0-9]*)?\.apk$'
}

upstream_version() {
	printf '%s\n' "$1" | sed 's/_alpha\([0-9][0-9]*\)/-alpha.\1/'
}

apk_version() {
	printf '%s\n' "$1" | sed 's/-alpha\.\([0-9][0-9]*\)/_alpha\1/'
}

shown_version() {
	upstream_version "$1" | sed 's/-r[1-9][0-9]*$//'
}

versions_match() {
	expected="$(upstream_version "$1")"
	actual="$(upstream_version "$2")"
	[ "$actual" = "$expected" ] && return 0
	case "$expected" in
	*-r*) return 1 ;;
	esac
	# Published names identify an upstream version, while firmware recovery
	# builds may retain r2 or later. Explicit revisions above remain exact.
	[ "${actual%-r*}" = "$expected" ] || return 1
	printf '%s\n' "${actual##*-r}" | grep -Eq '^[1-9][0-9]*$'
}

package_arch() {
	apk query --installed --fields arch sing-box 2>/dev/null |
		sed -n 's/^Arch:[[:space:]]*//p' | head -n 1
}

core_version() {
	/usr/bin/sing-box version -n 2>/dev/null || true
}

core_tags() {
	/usr/bin/sing-box version 2>/dev/null |
		sed -n 's/^Tags:[[:space:]]*//p' | head -n 1
}

service_running() {
	/etc/init.d/sbproxy running sing-box-c >/dev/null 2>&1 ||
		/etc/init.d/sbproxy running sing-box-s >/dev/null 2>&1
}

capture_expected_cores() {
	expected_health="$work_dir/expected-cores.json"
	ucode /etc/sbproxy/scripts/check_core_health.uc snapshot > "$expected_health" 2>>"$LOG_FILE" || return 1
	jsonfilter -i "$expected_health" -e '@.instances' >/dev/null || return 1
	expected_instances="$(jsonfilter -i "$expected_health" -e '@.instances[*].name' || true)"
}

health_signature() {
	ucode /etc/sbproxy/scripts/check_core_health.uc check "$expected_health" 2>>"$LOG_FILE"
}

release_tag() {
	case "$(apk --print-arch 2>/dev/null)" in
	aarch64*) printf '%s\n' 'apk-packages-arm64' ;;
	x86_64*) printf '%s\n' 'apk-packages-amd64' ;;
	*) return 1 ;;
	esac
}

meta_value() {
	key="$1"
	[ -f "$ROLLBACK_META" ] || return 0
	sed -n "s/^${key}=//p" "$ROLLBACK_META" | head -n 1
}

preferred_proxy() {
	port="$(uci -q get sbproxy.infra.mixed_port)"
	case "$port" in
	''|*[!0-9]*) return 1 ;;
	esac
	/etc/init.d/sbproxy running sing-box-c >/dev/null 2>&1 || return 1
	printf 'http://127.0.0.1:%s\n' "$port"
}

curl_to_file() {
	url="$1"
	destination="$2"
	temporary="${destination}.part"
	proxy="$(preferred_proxy || true)"
	rm -f -- "$temporary"

	if [ -n "$proxy" ] && curl -fsSL --retry 2 --retry-delay 2 \
		--connect-timeout 10 --max-time 240 --speed-limit 1024 --speed-time 20 \
		--user-agent "$USER_AGENT" --proxy "$proxy" "$url" -o "$temporary" \
		>>"$LOG_FILE" 2>&1; then
		last_download_mode='proxy'
		mv -f -- "$temporary" "$destination"
		return 0
	fi

	rm -f -- "$temporary"
	if curl -fsSL --retry 2 --retry-delay 2 \
		--connect-timeout 10 --max-time 240 --speed-limit 1024 --speed-time 20 \
		--user-agent "$USER_AGENT" "$url" -o "$temporary" >>"$LOG_FILE" 2>&1; then
		last_download_mode='direct'
		mv -f -- "$temporary" "$destination"
		return 0
	fi

	rm -f -- "$temporary"
	return 1
}

core_arch() {
	case "$(apk --print-arch 2>/dev/null)" in
	aarch64*) printf '%s\n' arm64 ;;
	x86_64*) printf '%s\n' amd64 ;;
	*) return 1 ;;
	esac
}

fetch_assets() {
	arch="$(core_arch)" || return 2
	assets_file="$work_dir/assets"
	: > "$assets_file"
	page=1
	while :; do
		api_file="$work_dir/releases-$page.json"
		curl_to_file "https://api.github.com/repos/$REPOSITORY/releases?per_page=100&page=$page" "$api_file" || return 1
		ucode /usr/libexec/sbproxy-core-catalog.uc "$api_file" "$arch" >> "$assets_file" || return 1
		count="$(jsonfilter -i "$api_file" -e '@[*].id' | wc -l | tr -d ' ')"
		[ "$count" -ge 100 ] || break
		page=$((page + 1))
		# Bound router work; do not silently treat a truncated history as complete.
		[ "$page" -le 100 ] || return 1
	done
	[ -s "$assets_file" ]
}

find_recovery_asset() {
	wanted="$1"
	asset_by_name "$wanted" && return 0
	# One-time transition from firmware/rolling APK builds. This source is ONLY
	# used to prepare an emergency recovery, never offered for normal installs.
	tag="$(release_tag)" || return 1
	arch="$(core_arch)" || return 1
	legacy_file="$work_dir/legacy-release.json"
	curl_to_file "https://api.github.com/repos/$REPOSITORY/releases/tags/$tag" "$legacy_file" || return 1
	ucode /usr/libexec/sbproxy-core-catalog.uc "$legacy_file" "$arch" legacy >> "$assets_file" || return 1
	asset_by_name "$wanted"
}

asset_by_name() {
	local wanted="$1" name url digest size created
	while IFS="$TAB" read -r name url digest size created; do
		[ "$name" = "$wanted" ] || continue
		printf '%s\t%s\t%s\t%s\t%s\n' \
			"$name" "$url" "$digest" "$size" "$created"
		return 0
	done < "$assets_file"
	return 1
}

verify_digest() {
	file="$1"
	digest="${2#sha256:}"
	actual="$(sha256sum "$file" | awk '{ print $1 }')"
	[ "$actual" = "$digest" ]
}

ensure_persistent_storage() {
	required_bytes="$1"
	available_kb="$(df -Pk "$STATE_DIR" 2>/dev/null | awk 'NR == 2 { print $4 }')"
	case "$available_kb" in
	''|*[!0-9]*) return 1 ;;
	esac
	[ $((available_kb * 1024)) -ge "$required_bytes" ]
}

validate_arch() {
	system_arch="$(apk --print-arch 2>/dev/null)"
	apk_arch="$1"
	case "$system_arch:$apk_arch" in
	aarch64:aarch64|aarch64:aarch64_*) return 0 ;;
	x86_64:x86_64) return 0 ;;
	*) return 1 ;;
	esac
}

validate_binary() {
	binary="$1"
	version_output="$("$binary" version 2>>"$LOG_FILE")" || return 1
	tags="$(printf '%s\n' "$version_output" | sed -n 's/^Tags:[[:space:]]*//p')"
	word_tags="$(printf '%s' "$tags" | tr ',' ' ')"
	for required in $REQUIRED_TAGS; do
		printf '%s\n' "$word_tags" | grep -qw "$required" || {
			log "Missing required build tag: $required"
			return 1
		}
	done
	"$binary" api tailscale route list --help >>"$LOG_FILE" 2>&1 || return 1
	return 0
}

validate_configs() {
	binary="$1"
	checked=0
	for config in /var/run/sbproxy/sing-box-c.json /var/run/sbproxy/sing-box-s.json; do
		[ -s "$config" ] || continue
		"$binary" check --config "$config" >>"$LOG_FILE" 2>&1 || return 1
		checked=1
	done
	[ "$checked" = '0' ] || return 0

	client_config="$work_dir/generated-client.json"
	server_config="$work_dir/generated-server.json"
	SBPROXY_CLIENT_CONFIG_PATH="$client_config" \
		ucode -S /etc/sbproxy/scripts/generate_client.uc >>"$LOG_FILE" 2>&1 || return 1
	SBPROXY_SERVER_CONFIG_PATH="$server_config" \
		ucode -S /etc/sbproxy/scripts/generate_server.uc >>"$LOG_FILE" 2>&1 || return 1
	for config in "$client_config" "$server_config"; do
		[ -s "$config" ] || continue
		"$binary" check --config "$config" >>"$LOG_FILE" 2>&1 || return 1
	done
	return 0
}

validate_apk() {
	file="$1"
	expected_version="$2"
	metadata="$(apk adbdump "$file" 2>>"$LOG_FILE")" || return 1
	name="$(printf '%s\n' "$metadata" | awk '/^  name: / { sub(/^  name: /, ""); print; exit }')"
	version="$(printf '%s\n' "$metadata" | awk '/^  version: / { sub(/^  version: /, ""); print; exit }')"
	arch="$(printf '%s\n' "$metadata" | awk '/^  arch: / { sub(/^  arch: /, ""); print; exit }')"
	[ "$name" = 'sing-box' ] || return 1
	versions_match "$expected_version" "$version" || return 1
	validate_arch "$arch" || return 1

	extract_dir="$work_dir/extract"
	rm -rf -- "$extract_dir"
	mkdir -p "$extract_dir"
	apk --allow-untrusted extract --destination "$extract_dir" "$file" \
		>>"$LOG_FILE" 2>&1 || return 1
	[ -x "$extract_dir/usr/bin/sing-box" ] || return 1
	[ "$("$extract_dir/usr/bin/sing-box" version -n 2>>"$LOG_FILE")" = "$(shown_version "$expected_version")" ] || return 1
	validate_binary "$extract_dir/usr/bin/sing-box" || return 1
	validate_configs "$extract_dir/usr/bin/sing-box" || return 1
	rm -rf -- "$extract_dir"
	return 0
}

wait_for_service() {
	count=0
	stable=0
	last_signature=''
	while [ "$count" -lt 30 ]; do
		if signature="$(health_signature)" && [ -n "$signature" ]; then
			if [ "$signature" = "$last_signature" ]; then stable=$((stable + 1)); else stable=1; fi
			last_signature="$signature"
		else
			stable=0
			last_signature=''
		fi
		[ "$stable" -ge 5 ] && return 0
		sleep 1
		count=$((count + 1))
	done
	return 1
}

restart_if_needed() {
	was_running="$1"
	[ "$was_running" = '1' ] || return 0
	progress restarting
	/etc/init.d/sbproxy restart >>"$LOG_FILE" 2>&1 || return 1
	progress checking_health
	refresh_runtime_health_plan || return 1
	wait_for_service
}

install_apk() {
	apk_file="$1"
	apk add --allow-untrusted --upgrade --force-reinstall "$apk_file" \
		>>"$LOG_FILE" 2>&1
}

restore_rollback() {
	was_running="$1"
	log 'Restoring the previous core automatically.'
	progress restoring
	install_apk "$ROLLBACK_APK" || return 1
	validate_binary /usr/bin/sing-box || return 1
	restart_if_needed "$was_running"
}

emit_status() {
	system_arch="$(apk --print-arch 2>/dev/null || true)"
	tag="$(release_tag 2>/dev/null || true)"
	current_package="$(package_version)"
	current_core="$(core_version)"
	tags="$(core_tags)"
	installed_arch="$(package_arch)"
	running=0
	service_running && running=1
	busy=0
	flock -n "$LOCK_FILE" -c true >/dev/null 2>&1 || busy=1
	rollback_available=0
	[ -s "$ROLLBACK_APK" ] && [ -s "$ROLLBACK_META" ] && rollback_available=1
	overlay_available="$(df -Pk "$STATE_DIR" 2>/dev/null | awk 'NR == 2 { print $4 }')"
	[ -n "$overlay_available" ] || overlay_available="$(df -Pk /etc | awk 'NR == 2 { print $4 }')"
	tmp_available="$(df -Pk /tmp | awk 'NR == 2 { print $4 }')"

	emit manager_supported "$([ -n "$tag" ] && printf 1 || printf 0)"
	emit repository "$REPOSITORY"
	emit release_tag ""
	emit system_arch "$system_arch"
	emit package_arch "$installed_arch"
	emit package_version "$(shown_version "$current_package")"
	emit version "$current_core"
	emit plugin_version "$(installed_plugin_version luci-app-sbproxy)"
	emit plugin_language_version "$(installed_plugin_version luci-i18n-sbproxy-zh-cn)"
	emit tags "$tags"
	emit required_tags "$(printf '%s' "$REQUIRED_TAGS" | tr ' ' ',')"
	emit service_running "$running"
	emit busy "$busy"
	emit overlay_available_kb "${overlay_available:-0}"
	emit tmp_available_kb "${tmp_available:-0}"
	emit rollback_available "$rollback_available"
	if [ "$rollback_available" = '1' ]; then
		emit rollback_version "$(meta_value version)"
		emit rollback_package_version "$(shown_version "$(meta_value package_version)")"
		emit rollback_saved_at "$(meta_value saved_at)"
		emit rollback_sha256 "$(meta_value sha256)"
	fi
}

check_updates() {
	fetch_assets || {
		case "$?" in
		2) fail unsupported_architecture 'Core updates are not available for this architecture.' ;;
		*) fail release_query_failed 'Unable to query the SBProxy package release.' ;;
		esac
	}

	current="$(shown_version "$(package_version)")"
	latest=''
	latest_alpha=''
	while IFS="$TAB" read -r name url digest size created; do
		candidate="${name#sing-box-}"
		candidate="${candidate%.apk}"
		shown="$(shown_version "$candidate")"
		relation='unknown'
		if [ -n "$current" ]; then
			comparison="$(apk version --test "$(apk_version "$current")" "$(apk_version "$shown")" 2>/dev/null || true)"
			if [ "$comparison" = '<' ]; then
				relation='newer'
			elif [ "$comparison" = '=' ]; then
				relation='current'
			else
				relation='older'
			fi
		fi
		case "$shown" in
		*-alpha.*)
			if [ -z "$latest_alpha" ] || \
			   [ "$(apk version --test "$(apk_version "$latest_alpha")" "$(apk_version "$shown")" 2>/dev/null || true)" = '<' ]; then
				latest_alpha="$shown"
			fi
			;;
		*)
			if [ -z "$latest" ] || \
			   [ "$(apk version --test "$latest" "$shown" 2>/dev/null || true)" = '<' ]; then
				latest="$shown"
			fi
			;;
		esac
		printf 'asset=%s\t%s\t%s\t%s\t%s\t%s\n' \
			"$name" "$shown" "$relation" "$size" "$created" "${digest#sha256:}"
	done < "$assets_file"
	emit latest_package_version "$latest"
	emit latest_alpha_package_version "$latest_alpha"
	emit download_mode "$last_download_mode"
}

save_rollback() {
	file="$1"
	version="$2"
	digest="$3"
	url="$4"
	created="$5"
	core="$(shown_version "$version")"
	sha="${digest#sha256:}"
	metadata_file="$work_dir/rollback.meta"
	chmod 600 "$file"
	{
		printf 'version=%s\n' "$core"
		printf 'package_version=%s\n' "$version"
		printf 'sha256=%s\n' "$sha"
		printf 'source_url=%s\n' "$url"
		printf 'source_created_at=%s\n' "$created"
		printf 'saved_at=%s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
	} > "$metadata_file"
	chmod 600 "$metadata_file"
	mv -f -- "$file" "$ROLLBACK_APK"
	mv -f -- "$metadata_file" "$ROLLBACK_META"
}

upgrade_core() {
	target="$1"
	core_package_name "$target" || \
		fail invalid_target 'Invalid core package selection.'
	progress querying
	fetch_assets || fail release_query_failed 'Unable to query the SBProxy package release.'
	target_asset="$(asset_by_name "$target")" || \
		fail target_unavailable 'The selected core package is no longer available.'
	IFS="$TAB" read -r target_name target_url target_digest target_size target_created <<EOF
$target_asset
EOF
	target_version="${target_name#sing-box-}"
	target_version="${target_version%.apk}"
	current="$(package_version)"
	[ -n "$current" ] || fail current_version_unknown 'Unable to determine the installed core package version.'

	current_name="sing-box-$(upstream_version "$current").apk"
	current_asset="$(find_recovery_asset "$current_name")" || \
		current_asset="$(find_recovery_asset "sing-box-$(shown_version "$current").apk")" || \
		fail rollback_source_unavailable \
		'The installed core package is no longer in the trusted release, so a safe rollback cannot be prepared.'
	IFS="$TAB" read -r current_name current_url current_digest current_size current_created <<EOF
$current_asset
EOF
	max_package_size="$target_size"
	[ "$current_size" -le "$max_package_size" ] || max_package_size="$current_size"
	required_bytes=$((target_size + current_size + max_package_size * 3 + 16 * 1024 * 1024))
	ensure_persistent_storage "$required_bytes" || \
		fail insufficient_storage 'Not enough persistent storage is available to validate the upgrade and keep a rollback package.'

	log "Preparing core upgrade from $current to $target_version."
	candidate_apk="$work_dir/candidate.apk"
	progress downloading
	curl_to_file "$target_url" "$candidate_apk" || \
		fail download_failed 'Unable to download the selected core package.'
	progress validating
	verify_digest "$candidate_apk" "$target_digest" || \
		fail checksum_mismatch 'The downloaded core package failed SHA-256 verification.'
	validate_apk "$candidate_apk" "$target_version" || \
		fail candidate_rejected 'The downloaded package failed metadata, feature, or configuration validation.'

	progress preparing_recovery
	curl_to_file "$current_url" "$work_dir/rollback.apk" || \
		fail rollback_download_failed 'Unable to download the current core package for rollback.'
	verify_digest "$work_dir/rollback.apk" "$current_digest" || \
		fail rollback_checksum_mismatch 'The rollback package failed SHA-256 verification.'
	validate_apk "$work_dir/rollback.apk" "$current" || \
		fail rollback_rejected 'The rollback package failed validation.'
	save_rollback "$work_dir/rollback.apk" "$current" "$current_digest" \
		"$current_url" "$current_created"

	capture_expected_cores || fail health_snapshot_failed 'Unable to capture the expected core instances.'
	was_running=0
	[ -z "$expected_instances" ] || was_running=1
	progress installing
	if ! install_apk "$candidate_apk" || \
	   ! versions_match "$target_version" "$(package_version)" || \
	   ! validate_binary /usr/bin/sing-box || \
	   ! restart_if_needed "$was_running"; then
		if restore_rollback "$was_running"; then
			emit automatic_rollback 1
			fail upgrade_failed_rolled_back \
				'The new core failed to install or start; the previous core was restored.'
		fi
		emit automatic_rollback 0
		fail upgrade_and_rollback_failed \
			'The new core failed and automatic rollback also failed. Check the core manager log immediately.'
	fi

	log "Core upgrade completed: $current -> $target_version."
	if [ "$action" = 'rollback' ]; then emit rolled_back 1; else emit upgraded 1; fi
	emit previous_package_version "$current"
	emit package_version "$target_version"
	emit download_mode "$last_download_mode"
}


installed_plugin_version() {
	apk query --installed --fields version "$1" 2>/dev/null |
		sed -n 's/^Version:[[:space:]]*//p' | head -n 1
}

plugin_package_name() {
	printf '%s\n' "$1" | grep -Eq '^luci-app-sbproxy-[0-9]+\.[0-9]+\.[0-9]+-r[1-9][0-9]*\.apk$'
}

fetch_plugin_assets() {
	local arch release
	arch="$(core_arch)" || return 2
	release="$work_dir/plugin-release.json"
	curl_to_file "https://api.github.com/repos/$REPOSITORY/releases/tags/apk-packages-$arch" "$release" || return 1
	assets_file="$work_dir/plugin-assets"
	ucode /usr/libexec/sbproxy-plugin-catalog.uc "$release" "$arch" > "$assets_file" || return 1
	[ -s "$assets_file" ]
}

check_plugin_updates() {
	local current candidate relation latest='' name url digest size created language
	fetch_plugin_assets || fail release_query_failed 'Unable to query the SBProxy package release.'
	current="$(installed_plugin_version luci-app-sbproxy)"
	language="$(installed_plugin_version luci-i18n-sbproxy-zh-cn)"
	emit plugin_version "$current"
	while IFS="$TAB" read -r name url digest size created; do
		plugin_package_name "$name" || continue
		candidate="${name#luci-app-sbproxy-}"; candidate="${candidate%.apk}"
		# Keep an installed translation on the same package revision.
		[ -z "$language" ] || asset_by_name "luci-i18n-sbproxy-zh-cn-$candidate.apk" >/dev/null || continue
		relation=unknown
		if [ -n "$current" ]; then
			case "$(apk version --test "$current" "$candidate")" in
			'<') relation=newer ;; '=') relation=current ;; '>') relation=older ;;
			esac
		fi
		if [ -z "$latest" ] || [ "$(apk version --test "$latest" "$candidate")" = '<' ]; then latest="$candidate"; fi
		printf 'asset=%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$candidate" "$relation" "$size" "$created" "${digest#sha256:}"
	done < "$assets_file"
	emit latest_package_version "$latest"
}

validate_plugin_apk() {
	local file="$1" expected_name="$2" expected_version="$3" metadata name version arch
	metadata="$(apk adbdump "$file" 2>>"$LOG_FILE")" || return 1
	name="$(printf '%s\n' "$metadata" | awk '/^  name: / { print $2; exit }')"
	version="$(printf '%s\n' "$metadata" | awk '/^  version: / { print $2; exit }')"
	arch="$(printf '%s\n' "$metadata" | awk '/^  arch: / { print $2; exit }')"
	[ "$name" = "$expected_name" ] && [ "$version" = "$expected_version" ] || return 1
	[ "$arch" = noarch ] || [ "$arch" = all ] || validate_arch "$arch"
}

prepare_plugin_package() {
	local package="$1" version="$2" destination="$3" entry name url digest size created
	entry="$(asset_by_name "$package-$version.apk")" || return 1
	IFS="$TAB" read -r name url digest size created <<EOF
$entry
EOF
	curl_to_file "$url" "$destination" && verify_digest "$destination" "$digest" &&
		validate_plugin_apk "$destination" "$package" "$version"
}

install_plugin_packages() {
	validate_plugin_plan "$@" || return 1
	apk add --no-network --allow-untrusted --force-reinstall "$@" >>"$LOG_FILE" 2>&1
}

validate_plugin_plan() {
	# Naming sing-box as an APK argument would reinstall it with
	# --force-reinstall. Instead reject every plan that touches other packages.
	apk add --simulate --no-network --allow-untrusted --force-reinstall "$@" > "$work_dir/plugin-plan" 2>&1 || {
		cat "$work_dir/plugin-plan" >> "$LOG_FILE"
		return 1
	}
	cat "$work_dir/plugin-plan" >> "$LOG_FILE"
	awk '
		/^\([0-9]+\/[0-9]+\)/ {
			count++
			if ($2 !~ /^(Installing|Upgrading|Downgrading|Reinstalling)$/ ||
			    ($3 != "luci-app-sbproxy" && $3 != "luci-i18n-sbproxy-zh-cn")) bad=1
		}
		END { exit (bad || !count) }
	' "$work_dir/plugin-plan"
}

backup_plugin_config() {
	local destination="$1"
	set -- etc/config
	[ ! -d /etc/crontabs ] || set -- "$@" etc/crontabs
	tar -czf "$destination" -C / "$@" >>"$LOG_FILE" 2>&1
}

refresh_runtime_health_plan() {
	# Service restarts can regenerate random internal ports. Keep
	# every previously required instance, but validate its new configuration.
	ucode /etc/sbproxy/scripts/check_core_health.uc snapshot > "$work_dir/current-core-plan.json" 2>>"$LOG_FILE" || return 1
	ucode -e '
		import { readfile } from "fs";
		const before = json(readfile(ARGV[0]));
		const after = json(readfile(ARGV[1]));
		let required = [];
		for (let instance in before.instances) {
			const updated = filter(after.instances, entry => entry.name === instance.name)[0];
			if (!updated) die("Expected core instance disappeared: " + instance.name);
			push(required, updated);
		}
		print(sprintf("%J", { instances: required }));
	' "$expected_health" "$work_dir/current-core-plan.json" > "$work_dir/refreshed-health.new" 2>>"$LOG_FILE" || return 1
	mv "$work_dir/refreshed-health.new" "$work_dir/refreshed-health.json" || return 1
	expected_health="$work_dir/refreshed-health.json"
}

restart_plugin_services() {
	[ "$was_running" = 1 ] || return 0
	progress restarting
	/etc/init.d/sbproxy restart >>"$LOG_FILE" 2>&1 || return 1
	refresh_runtime_health_plan || return 1
	wait_for_service
}

plugin_health() {
	[ "$(installed_plugin_version luci-app-sbproxy)" = "$plugin_target_version" ] || return 1
	[ -z "$plugin_language_version" ] ||
		[ "$(installed_plugin_version luci-i18n-sbproxy-zh-cn)" = "$plugin_target_version" ] || return 1
	[ "$(package_version)" = "$plugin_core_version" ] || return 1
	sha256sum -c "$work_dir/core-before.sha256" >>"$LOG_FILE" 2>&1 || return 1
	/etc/init.d/rpcd reload >>"$LOG_FILE" 2>&1 || return 1
	if [ "$was_running" = 1 ]; then
		progress checking_health
		refresh_runtime_health_plan || return 1
		wait_for_service || restart_plugin_services || return 1
	fi
	# Verify the management endpoint after rpcd has reloaded its package files.
	local tries=0
	while [ "$tries" -lt 10 ]; do
		ubus call luci.sbproxy core_status > "$work_dir/rpc-status.json" 2>>"$LOG_FILE" &&
			[ "$(jsonfilter -i "$work_dir/rpc-status.json" -e '@.code')" = 0 ] &&
			[ -n "$(jsonfilter -i "$work_dir/rpc-status.json" -e '@.version')" ] && return 0
		sleep 1
		tries=$((tries + 1))
	done
	return 1
}

upgrade_plugin() {
	local target="$1" previous rollback_dir
	plugin_package_name "$target" || fail invalid_target 'Invalid plugin package selection.'
	progress querying
	fetch_plugin_assets || fail release_query_failed 'Unable to query the SBProxy package release.'
	plugin_target_version="${target#luci-app-sbproxy-}"; plugin_target_version="${plugin_target_version%.apk}"
	previous="$(installed_plugin_version luci-app-sbproxy)"
	plugin_language_version="$(installed_plugin_version luci-i18n-sbproxy-zh-cn)"
	plugin_core_version="$(package_version)"
	[ -n "$previous" ] && [ -n "$plugin_core_version" ] || fail current_version_unknown 'Unable to read installed package versions.'
	# v1 plugin updater supports upgrading/reinstalling. Older plugins may not
	# expose operation status, so do not offer downgrade as a successful update.
	[ "$(apk version --test "$previous" "$plugin_target_version")" != '>' ] || fail plugin_downgrade 'Select the current or a newer plugin version.'
	asset_by_name "$target" >/dev/null || fail target_unavailable 'The selected plugin package is no longer available.'
	ensure_persistent_storage 134217728 || fail insufficient_storage 'Not enough persistent storage for plugin recovery.'
	progress downloading
	prepare_plugin_package luci-app-sbproxy "$plugin_target_version" "$work_dir/plugin.apk" || fail candidate_rejected 'The plugin package could not be downloaded or verified.'
	set -- "$work_dir/plugin.apk"
	if [ -n "$plugin_language_version" ]; then
		prepare_plugin_package luci-i18n-sbproxy-zh-cn "$plugin_target_version" "$work_dir/language.apk" || fail candidate_rejected 'The matching language package could not be downloaded or verified.'
		set -- "$@" "$work_dir/language.apk"
	fi
	progress validating
	validate_plugin_plan "$@" ||
		fail candidate_rejected 'Package dependencies are not compatible with this firmware.'
	progress preparing_recovery
	prepare_plugin_package luci-app-sbproxy "$previous" "$work_dir/previous-plugin.apk" || fail rollback_source_unavailable 'The installed plugin package is no longer available for recovery.'
	if [ -n "$plugin_language_version" ]; then
		prepare_plugin_package luci-i18n-sbproxy-zh-cn "$plugin_language_version" "$work_dir/previous-language.apk" || fail rollback_source_unavailable 'The installed language package is no longer available for recovery.'
	fi
	rollback_dir="$STATE_DIR/plugin-recovery"
	mkdir -p "$rollback_dir" || fail temporary_directory_failed 'Unable to prepare plugin recovery.'
	chmod 700 "$rollback_dir"
	cp "$work_dir/previous-plugin.apk" "$rollback_dir/plugin.apk" || fail temporary_directory_failed 'Unable to save plugin recovery.'
	[ -z "$plugin_language_version" ] || cp "$work_dir/previous-language.apk" "$rollback_dir/language.apk" || fail temporary_directory_failed 'Unable to save language recovery.'
	printf 'plugin=%s\nlanguage=%s\n' "$previous" "$plugin_language_version" > "$rollback_dir/versions"
	# Package migrations can touch these shared OpenWrt configuration files.
	backup_plugin_config "$rollback_dir/config.tar.gz" || fail temporary_directory_failed 'Unable to back up configuration.'
	sha256sum /usr/bin/sing-box > "$work_dir/core-before.sha256" || fail health_snapshot_failed 'Unable to record the current core.'
	capture_expected_cores || fail health_snapshot_failed 'Unable to capture service health.'
	was_running=0; [ -z "$expected_instances" ] || was_running=1
	progress installing
	if install_plugin_packages "$@" && plugin_health; then
		emit upgraded 1
		emit component plugin
		emit package_version "$plugin_target_version"
		return 0
	fi
	progress restoring
	set -- "$rollback_dir/plugin.apk"
	[ -z "$plugin_language_version" ] || set -- "$@" "$rollback_dir/language.apk"
	if install_plugin_packages "$@" &&
	   [ "$(installed_plugin_version luci-app-sbproxy)" = "$previous" ] &&
	   { [ -z "$plugin_language_version" ] || [ "$(installed_plugin_version luci-i18n-sbproxy-zh-cn)" = "$plugin_language_version" ]; } &&
	   sha256sum -c "$work_dir/core-before.sha256" >>"$LOG_FILE" 2>&1 &&
	   tar -xzf "$rollback_dir/config.tar.gz" -C / >>"$LOG_FILE" 2>&1 &&
	   /etc/init.d/rpcd reload >>"$LOG_FILE" 2>&1 && restart_plugin_services; then
		emit automatic_rollback 1
		fail plugin_upgrade_rolled_back 'The plugin update failed; previous packages and configuration were restored.'
	fi
	emit automatic_rollback 0
	fail plugin_recovery_failed 'Plugin update and recovery failed. Check the version manager log.'
}


action="${1:-status}"
mkdir -p "$STATE_DIR" "$(dirname "$LOCK_FILE")" "$(dirname "$LOG_FILE")"
chmod 700 "$STATE_DIR"

case "$action" in
operation)
	emit_operation "${2:-}"
	;;
start-upgrade|start-rollback|start-plugin-upgrade)
	[ "$#" -eq 3 ] || fail invalid_target 'A target and operation ID are required.'
	start_operation "${action#start-}" "$2" "$3"
	;;
worker)
	[ "$#" -eq 4 ] || exit 1
	exec 9>"$LOCK_FILE"
	flock 9 || exit 1
	grep -Fxq "operation_id=$4" "$JOB_DIR/status" || exit 1
	action="$2"
	case "$action" in upgrade|rollback|plugin-upgrade) ;; *) exit 1 ;; esac
	job_action="$action"
	job_target="$3"
	job_id="$4"
	exec >"$JOB_DIR/result" 2>>"$LOG_FILE"
	trap finish_worker EXIT
	: > "$LOG_FILE"
	work_dir="$(mktemp -d "$STATE_DIR/.work.XXXXXX")" || fail temporary_directory_failed \
		'Unable to create a temporary directory.'
	if [ "$action" = plugin-upgrade ]; then upgrade_plugin "$job_target"; else upgrade_core "$job_target"; fi
	;;
status)
	emit_status
	;;
check)
	work_dir="$(mktemp -d /tmp/sbproxy-core.XXXXXX)" || fail temporary_directory_failed \
		'Unable to create a temporary directory.'
	emit_status
	check_updates
	;;
plugin-check)
	work_dir="$(mktemp -d /tmp/sbproxy-plugin.XXXXXX)" || fail temporary_directory_failed 'Unable to create a temporary directory.'
	check_plugin_updates
	;;
upgrade|rollback)
	exec 9>"$LOCK_FILE"
	flock -n 9 || fail operation_in_progress 'Another core operation is already in progress.'
	: > "$LOG_FILE"
	work_dir="$(mktemp -d "$STATE_DIR/.work.XXXXXX")" || fail temporary_directory_failed \
		'Unable to create a temporary directory.'
	[ "$#" -eq 2 ] || fail invalid_target 'A repository core version must be selected.'
	upgrade_core "$2"
	;;
*)
	fail invalid_action 'Unsupported core manager action.'
	;;
esac

exit 0
