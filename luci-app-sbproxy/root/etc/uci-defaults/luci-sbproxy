#!/bin/sh

ucode "/etc/sbproxy/scripts/migrate_config.uc" || exit 1

if ! /usr/libexec/sbproxy-runtime-init; then
	printf '%s\n' 'SBProxy: failed to initialize runtime ports.' >&2
	exit 1
fi

if ! uci -q batch <<-EOF >"/dev/null"
	delete firewall.homeproxy_forward
	delete firewall.homeproxy_input
	delete firewall.homeproxy_post

	delete firewall.sbproxy_pre

	delete firewall.sbproxy_forward
	delete firewall.sbproxy_input
	set firewall.sbproxy_input=include
	set firewall.sbproxy_input.type=nftables
	set firewall.sbproxy_input.path="/var/run/sbproxy/fw4_input.nft"
	set firewall.sbproxy_input.position="chain-pre"
	set firewall.sbproxy_input.chain="input"

	delete firewall.sbproxy_post
	commit firewall
EOF
then
	printf '%s\n' 'SBProxy: failed to configure firewall includes.' >&2
	exit 1
fi

# Older packages marked caches, dashboards and downloaded APKs as configuration,
# so sysupgrade copied them into every backup. Drop those preserved paths.
if [ -f /etc/sysupgrade.conf ]; then
	sed -i \
		-e '\|^/etc/sbproxy/retired-adaptive/$|d' \
		-e '\|^/etc/sbproxy/cache/$|d' \
		-e '\|^/etc/sbproxy/core/$|d' \
		-e '\|^/etc/sbproxy/dashboard/$|d' \
		-e '\|^/etc/sbproxy/dashboard-singbox/$|d' \
		-e '\|^/etc/sbproxy/dashboard-yacd/$|d' \
		-e '\|^/etc/sbproxy/dashboard-metacubexd/$|d' \
		-e '\|^/etc/sbproxy/tailscale/$|d' \
		/etc/sysupgrade.conf
fi

rm -rf /tmp/luci-*
[ -x /usr/libexec/sbproxy-dashboard-select ] && /usr/libexec/sbproxy-dashboard-select
rm -f /etc/sbproxy/dashboard/.etag /etc/sbproxy/dashboard-singbox/.etag \
	/etc/sbproxy/dashboard-yacd/.etag /etc/sbproxy/dashboard-metacubexd/.etag
for dashboard_dir in /etc/sbproxy/dashboard /etc/sbproxy/dashboard-singbox \
	/etc/sbproxy/dashboard-yacd /etc/sbproxy/dashboard-metacubexd; do
	[ ! -d "$dashboard_dir" ] || chmod -R a+rX "$dashboard_dir"
done
[ ! -f /var/run/sbproxy/sing-box-c.json ] || \
	/etc/init.d/sbproxy restart >/dev/null 2>&1 || \
	printf '%s\n' 'SBProxy: failed to restart the running service after upgrade.' >&2
exit 0
